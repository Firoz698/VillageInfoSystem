@{
    ViewData["Title"] = "সব সংবাদ";
    var info = ViewBag.Info as VillageInfoSystem.Models.VillageInfo;
    var newsList = ViewBag.NewsList as List<VillageInfoSystem.Models.News>;
    var categories = ViewBag.Categories as List<string>;
    string? currentCategory = ViewBag.CurrentCategory;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
}

<style>
    .page-hero {
        background: linear-gradient(135deg, #082818 0%, #0d3520 50%, var(--green-dark) 100%);
        padding: 100px 2rem 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .page-hero::before {
        content: '';
        position: absolute;
        width: 600px; height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(45,155,90,0.1) 0%, transparent 65%);
        top: -200px; right: -100px;
        pointer-events: none;
    }

    .page-hero-tag {
        display: inline-block;
        background: rgba(200,153,58,0.18);
        color: var(--gold-light);
        border: 1px solid rgba(200,153,58,0.3);
        padding: 0.35rem 1rem;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 1rem;
        position: relative;
    }

    .page-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        font-weight: 900;
        color: white;
        margin-bottom: 0.6rem;
        position: relative;
    }

    .page-hero p { color: rgba(255,255,255,0.65); font-size: 0.95rem; position: relative; }

    .page-hero-back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.4rem;
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.8);
        padding: 0.5rem 1.2rem;
        border-radius: 50px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.2s;
        position: relative;
    }

    .page-hero-back:hover { background: rgba(255,255,255,0.18); color: white; }

    .allnews-section { background: #f5f9f6; padding: 60px 0 80px; }

    .filter-bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-bottom: 2.2rem;
        padding-bottom: 1.2rem;
        border-bottom: 1px solid rgba(26,107,60,0.1);
    }

    .filter-label { font-size: 0.82rem; font-weight: 700; color: var(--text-light); margin-right: 0.2rem; }

    .filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.38rem 1rem;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        border: 1.5px solid rgba(26,107,60,0.15);
        color: var(--text-light);
        background: white;
        transition: all 0.22s;
    }

    .filter-btn:hover { border-color: var(--green); color: var(--green); box-shadow: 0 2px 10px rgba(26,107,60,0.1); }

    .filter-btn.active {
        background: linear-gradient(135deg, var(--green), var(--green-light));
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 14px rgba(26,107,60,0.28);
    }

    .news-count-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .news-count-text { font-size: 0.88rem; color: var(--text-light); }
    .news-count-text strong { color: var(--green-dark); font-weight: 800; }

    .allnews-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .an-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(26,107,60,0.09);
        box-shadow: 0 4px 18px rgba(26,107,60,0.06);
        transition: all 0.3s;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .an-card:hover { transform: translateY(-7px); box-shadow: 0 18px 45px rgba(26,107,60,0.14); border-color: rgba(26,107,60,0.17); }

    .an-card::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--green), var(--gold));
        transform: scaleX(0);
        transition: transform 0.3s;
        transform-origin: left;
    }

    .an-card:hover::after { transform: scaleX(1); }

    .an-featured-badge {
        position: absolute;
        top: 12px; left: 12px;
        background: linear-gradient(135deg, var(--gold), var(--gold-light));
        color: var(--green-dark);
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.22rem 0.65rem;
        border-radius: 50px;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(200,153,58,0.4);
    }

    .an-img {
        width: 100%; height: 190px;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, var(--green-dark), var(--green-light));
        flex-shrink: 0;
    }

    .an-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
    .an-card:hover .an-img img { transform: scale(1.06); }

    .an-img-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 45%, rgba(0,0,0,0.3)); z-index: 1; }
    .an-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3.2rem; }

    .an-body { padding: 1.2rem 1.3rem 1.4rem; display: flex; flex-direction: column; flex: 1; }

    .an-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.65rem; flex-wrap: wrap; }

    .an-cat {
        background: rgba(26,107,60,0.08);
        color: var(--green);
        border: 1px solid rgba(26,107,60,0.15);
        padding: 0.15rem 0.65rem;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .an-date { font-size: 0.72rem; color: var(--text-light); margin-left: auto; }

    .an-title {
        font-family: 'Playfair Display', serif;
        font-size: 0.97rem;
        font-weight: 800;
        color: var(--green-dark);
        line-height: 1.4;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.2s;
    }

    .an-card:hover .an-title { color: var(--green); }

    .an-desc {
        color: var(--text-light);
        font-size: 0.85rem;
        line-height: 1.65;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 0.9rem;
    }

    .an-more {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--green);
        font-weight: 700;
        font-size: 0.83rem;
        margin-top: auto;
        transition: gap 0.2s;
    }

    .an-card:hover .an-more { gap: 0.55rem; }

    .allnews-empty { grid-column: 1/-1; text-align: center; padding: 5rem 2rem; color: var(--text-light); }
    .allnews-empty-icon { font-size: 4rem; margin-bottom: 1rem; opacity: 0.35; }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 3rem;
        flex-wrap: wrap;
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px; height: 42px;
        border-radius: 12px;
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none;
        border: 1.5px solid rgba(26,107,60,0.15);
        color: var(--green-dark);
        background: white;
        transition: all 0.22s;
    }

    .page-btn:hover { border-color: var(--green); color: var(--green); box-shadow: 0 3px 12px rgba(26,107,60,0.12); }

    .page-btn.active {
        background: linear-gradient(135deg, var(--green), var(--green-light));
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 14px rgba(26,107,60,0.3);
    }

    .page-btn.disabled { opacity: 0.35; pointer-events: none; }
    .page-btn.wide { width: auto; padding: 0 1rem; }

    /* Footer */
    footer {
        background: linear-gradient(180deg, #082818 0%, var(--green-dark) 100%);
        color: rgba(255,255,255,0.8);
        text-align: center;
        padding: 3rem 2rem 2rem;
        position: relative;
        overflow: hidden;
    }

    footer::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold)); }
    .footer-logo { font-family: 'Playfair Display', serif; font-size: 1.7rem; color: white; font-weight: 900; margin-bottom: 0.5rem; }
    .footer-links { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin: 1.2rem 0; }

    .footer-links a {
        color: rgba(255,255,255,0.65);
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 500;
        padding: 0.35rem 0.8rem;
        border-radius: 50px;
        transition: all 0.2s;
    }

    .footer-links a:hover { background: rgba(255,255,255,0.08); color: var(--gold-light); }
    .footer-copy { font-size: 0.82rem; color: rgba(255,255,255,0.4); }
    .footer-dev { margin-top: 0.6rem; font-size: 0.76rem; color: rgba(255,255,255,0.3); }

    @@media (max-width: 960px) { .allnews-grid { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 580px) { .allnews-grid { grid-template-columns: 1fr; } .page-hero h1 { font-size: 1.7rem; } }
</style>

<!-- Page Hero -->
<div class="page-hero">
    <div class="page-hero-tag">📰 সংবাদ আর্কাইভ</div>
    <h1>সব সংবাদ</h1>
    <p>খোকসা মল্লিক পাড়া গ্রামের সকল খবর ও ঘটনাবলি</p>
    <a href="/" class="page-hero-back">← হোমপেজে ফিরুন</a>
</div>

<!-- Main Content -->
<div class="allnews-section">
    <div class="container">

        @if (categories != null && categories.Any())
        {
            <div class="filter-bar">
                <span class="filter-label">ফিল্টার:</span>
                <a href="/Home/AllNews" class="filter-btn @(string.IsNullOrEmpty(currentCategory) ? "active" : "")">🗂️ সব</a>
                @foreach (var cat in categories)
                {
                    <a href="/Home/AllNews?category=@Uri.EscapeDataString(cat)"
                       class="filter-btn @(currentCategory == cat ? "active" : "")">
                        @cat
                    </a>
                }
            </div>
        }

        <div class="news-count-bar">
            <p class="news-count-text">
                মোট <strong>@totalCount</strong> টি সংবাদ
                @if (!string.IsNullOrEmpty(currentCategory))
                {
                    <text> — <em>@currentCategory</em> ক্যাটাগরিতে</text>
                }
            </p>
            @if (totalPages > 1)
            {
                <p class="news-count-text">পৃষ্ঠা <strong>@currentPage</strong> / @totalPages</p>
            }
        </div>

        <div class="allnews-grid">
            @if (newsList != null && newsList.Any())
            {
                foreach (var n in newsList)
                {
                    <a href="/Home/NewsDetails/@n.Id" class="an-card">
                        <div class="an-img">
                            @if (!string.IsNullOrEmpty(n.ImagePath))
                            {
                                <img src="@n.ImagePath" alt="@n.Title" loading="lazy" />
                                <div class="an-img-overlay"></div>
                            }
                            else
                            {
                                <div class="an-img-placeholder">@n.Icon</div>
                            }
                            @if (n.IsFeatured)
                            {
                                <div class="an-featured-badge">⭐ শীর্ষ সংবাদ</div>
                            }
                        </div>
                        <div class="an-body">
                            <div class="an-meta">
                                <span class="an-cat">@n.Category</span>
                                <span class="an-date">📅 @n.PublishedAt.ToString("dd MMM, yyyy")</span>
                            </div>
                            <div class="an-title">@n.Title</div>
                            <div class="an-desc">
                                @(n.Description?.Length > 120
                                    ? n.Description.Substring(0, 120) + "…"
                                    : n.Description)
                            </div>
                            <span class="an-more">বিস্তারিত পড়ুন →</span>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="allnews-empty">
                    <div class="allnews-empty-icon">📭</div>
                    <p>কোনো সংবাদ পাওয়া যায়নি।</p>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            string catParam = !string.IsNullOrEmpty(currentCategory) ? "&category=" + Uri.EscapeDataString(currentCategory) : "";
            <div class="pagination">
                <a href="/Home/AllNews?page=@(currentPage - 1)@catParam"
                   class="page-btn wide @(currentPage <= 1 ? "disabled" : "")">← আগে</a>

                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                    {
                        <a href="/Home/AllNews?page=@p@catParam"
                           class="page-btn @(p == currentPage ? "active" : "")">@p</a>
                    }
                    else if (p == currentPage - 3 || p == currentPage + 3)
                    {
                        <span style="color:var(--text-light);padding:0 0.2rem;">…</span>
                    }
                }

                <a href="/Home/AllNews?page=@(currentPage + 1)@catParam"
                   class="page-btn wide @(currentPage >= totalPages ? "disabled" : "")">পরে →</a>
            </div>
        }

    </div>
</div>

<footer>
    <div class="footer-logo">🌿 @(info?.VillageName ?? "খোকসা মল্লিক পাড়া")</div>
    <p style="font-size:0.88rem;margin-bottom:0.3rem;color:rgba(255,255,255,0.55);">
        @(info?.Division ?? "খুলনা বিভাগ"), বাংলাদেশ &nbsp;|&nbsp; আমাদের গর্বিত গ্রাম
    </p>
    <div class="footer-links">
        <a href="/">হোম</a>
        <a href="/#news">সংবাদ</a>
        <a href="/#about">পরিচিতি</a>
        <a href="/#facilities">সুবিধা</a>
        <a href="/#committee">কমিটি</a>
        <a href="/#gallery">গ্যালারি</a>
        <a href="/#contact">যোগাযোগ</a>
    </div>
    <div class="footer-copy">© ২০২৬ @(info?.VillageName ?? "খোকসা মল্লিক পাড়া") | সর্বস্বত্ব সংরক্ষিত</div>
    <div class="footer-dev">
        ✦ Developed with ❤️ by
        <a href="https://firozali.anticbyte.com/" target="_blank" rel="noopener"
           style="color:var(--gold-light);font-weight:700;text-decoration:none;">Md Firoz Ali</a>
        &nbsp;|&nbsp;
        <a href="/Admin/Login" style="color:rgba(200,153,58,0.5);font-size:0.7rem;text-decoration:none;">অ্যাডমিন</a>
    </div>
</footer>
