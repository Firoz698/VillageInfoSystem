@model VillageInfoSystem.Models.Institution
@{
    ViewData["Title"] = Model.Name;
    var info = ViewBag.Info as VillageInfoSystem.Models.VillageInfo;
}

<style>
    /* ═══════════════════════════════════════════
       HERO
    ═══════════════════════════════════════════ */
    .det-hero {
        background: linear-gradient(135deg, #082818 0%, #0d3520 50%, #1a6b3c 100%);
        padding: 130px 1.5rem 80px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .det-hero::before {
            content: '';
            position: absolute;
            width: 700px;
            height: 700px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(45,155,90,0.13) 0%, transparent 65%);
            top: -250px;
            right: -120px;
            pointer-events: none;
        }

        .det-hero::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(200,153,58,0.07) 0%, transparent 65%);
            bottom: -150px;
            left: -80px;
            pointer-events: none;
        }

    .det-back-btn {
        position: absolute;
        top: 88px;
        left: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        background: rgba(255,255,255,0.1);
        padding: 0.45rem 1.1rem;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,0.15);
        transition: all 0.22s;
        backdrop-filter: blur(6px);
        z-index: 2;
    }

        .det-back-btn:hover {
            background: rgba(255,255,255,0.18);
            color: white;
            transform: translateX(-3px);
        }

    .det-hero-icon {
        font-size: 4.5rem;
        margin-bottom: 1.1rem;
        display: block;
        position: relative;
        z-index: 1;
        filter: drop-shadow(0 4px 16px rgba(0,0,0,0.3));
    }

    .det-cat-tag {
        display: inline-block;
        background: rgba(200,153,58,0.22);
        color: #e8c76a;
        border: 1px solid rgba(200,153,58,0.38);
        padding: 0.32rem 1.1rem;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
        letter-spacing: 0.03em;
    }

    .det-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.6rem;
        font-weight: 900;
        color: white;
        margin-bottom: 0.9rem;
        position: relative;
        z-index: 1;
        line-height: 1.2;
    }

    .det-hero-desc {
        color: rgba(255,255,255,0.68);
        font-size: 1rem;
        max-width: 580px;
        margin: 0 auto;
        line-height: 1.78;
        position: relative;
        z-index: 1;
    }

    /* Quick stats bar */
    .det-hero-stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 2rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
    }

    .dhs-item {
        text-align: center;
    }

    .dhs-num {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 900;
        color: #e8c76a;
        display: block;
        line-height: 1;
    }

    .dhs-label {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.5);
        margin-top: 0.2rem;
    }

    .dhs-sep {
        width: 1px;
        background: rgba(255,255,255,0.12);
        align-self: stretch;
    }

    /* ═══════════════════════════════════════════
       BODY
    ═══════════════════════════════════════════ */
    .det-body {
        background: linear-gradient(160deg, #f3f8f5 0%, #eef5f1 100%);
        padding: 70px 1.5rem 80px;
    }

    .det-container {
        max-width: 1150px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 2.8rem;
        align-items: start;
    }

    /* ═══════════════════════════════════════════
       SIDEBAR
    ═══════════════════════════════════════════ */
    .det-sidebar {
        position: sticky;
        top: 90px;
    }

    .det-img-box {
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 56px rgba(15,66,38,0.18);
        margin-bottom: 1.5rem;
        cursor: zoom-in;
        position: relative;
    }

        .det-img-box img {
            width: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.45s ease;
        }

        .det-img-box:hover img {
            transform: scale(1.04);
        }

    .det-img-zoom-hint {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: rgba(0,0,0,0.52);
        backdrop-filter: blur(6px);
        color: white;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.28rem 0.75rem;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,0.15);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .det-img-box:hover .det-img-zoom-hint {
        opacity: 1;
    }

    .det-img-placeholder {
        width: 100%;
        aspect-ratio: 4/3;
        background: linear-gradient(135deg, #0d3520, #2d9b5a);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        color: white;
        font-size: 4.5rem;
        position: relative;
        overflow: hidden;
    }

        .det-img-placeholder::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }

    .det-info-box {
        background: white;
        border-radius: 20px;
        padding: 1.6rem;
        border: 1px solid rgba(26,107,60,0.09);
        box-shadow: 0 6px 24px rgba(26,107,60,0.06);
    }

        .det-info-box h3 {
            font-weight: 800;
            color: #0f4226;
            font-size: 0.92rem;
            margin-bottom: 1.1rem;
            padding-bottom: 0.65rem;
            border-bottom: 2px solid rgba(26,107,60,0.09);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

    .det-info-row {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.9rem;
        align-items: flex-start;
    }

        .det-info-row:last-child {
            margin-bottom: 0;
        }

    .det-info-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #1a6b3c, #2d9b5a);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.92rem;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(26,107,60,0.22);
    }

    .det-info-text strong {
        display: block;
        color: #0f4226;
        font-size: 0.72rem;
        font-weight: 700;
        margin-bottom: 0.12rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .det-info-text span {
        color: #444;
        font-size: 0.88rem;
    }

    /* ═══════════════════════════════════════════
       MAIN
    ═══════════════════════════════════════════ */
    .det-main {
    }

    .det-section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        color: #0f4226;
        font-weight: 900;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .det-desc-box {
        background: white;
        border-radius: 20px;
        padding: 1.9rem 2.1rem;
        border: 1px solid rgba(26,107,60,0.09);
        box-shadow: 0 6px 24px rgba(26,107,60,0.05);
        margin-bottom: 2.8rem;
        color: #3a3a3a;
        line-height: 2;
        font-size: 0.97rem;
        position: relative;
        overflow: hidden;
    }

        .det-desc-box::before {
            content: '"';
            position: absolute;
            top: -10px;
            left: 16px;
            font-size: 7rem;
            font-family: 'Playfair Display', serif;
            color: rgba(26,107,60,0.06);
            line-height: 1;
            pointer-events: none;
        }

    /* ═══════════════════════════════════════════
       MEMBERS
    ═══════════════════════════════════════════ */
    .det-members-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.3rem;
        margin-top: 1.2rem;
    }

    .det-member-card {
        background: white;
        border-radius: 20px;
        padding: 1.7rem 1.3rem 1.4rem;
        text-align: center;
        border: 1px solid rgba(26,107,60,0.09);
        box-shadow: 0 4px 18px rgba(26,107,60,0.05);
        transition: all 0.3s;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .det-member-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 0;
            background: linear-gradient(135deg, #082818, #1a6b3c);
            transition: height 0.35s;
            z-index: 0;
        }

        .det-member-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 50px rgba(26,107,60,0.15);
            border-color: transparent;
        }

            .det-member-card:hover::before {
                height: 100%;
            }

            .det-member-card:hover .det-member-name {
                color: white;
            }

            .det-member-card:hover .det-member-profession,
            .det-member-card:hover .det-member-phone {
                color: rgba(255,255,255,0.65);
            }

    .det-member-avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        border: 3px solid white;
        box-shadow: 0 6px 22px rgba(26,107,60,0.22);
        overflow: hidden;
        background: linear-gradient(135deg, #1a6b3c, #2d9b5a);
        position: relative;
        z-index: 1;
        transition: all 0.3s;
    }

    .det-member-card:hover .det-member-avatar {
        border-color: rgba(255,255,255,0.3);
        box-shadow: 0 8px 28px rgba(0,0,0,0.2);
        transform: scale(1.06);
    }

    .det-member-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .det-member-name {
        font-weight: 800;
        color: #0f4226;
        font-size: 0.92rem;
        margin-bottom: 0.38rem;
        position: relative;
        z-index: 1;
        transition: color 0.3s;
    }

    .det-member-role {
        display: inline-block;
        background: rgba(200,153,58,0.13);
        color: #b8892a;
        font-size: 0.73rem;
        font-weight: 700;
        padding: 0.2rem 0.7rem;
        border-radius: 50px;
        margin-bottom: 0.4rem;
        position: relative;
        z-index: 1;
        transition: all 0.3s;
    }

    .det-member-card:hover .det-member-role {
        background: rgba(200,153,58,0.28);
        color: #e8c76a;
    }

    .det-member-profession {
        color: #666;
        font-size: 0.8rem;
        margin-bottom: 0.28rem;
        position: relative;
        z-index: 1;
        transition: color 0.3s;
    }

    .det-member-phone {
        color: #888;
        font-size: 0.78rem;
        position: relative;
        z-index: 1;
        transition: color 0.3s;
    }

    .det-no-members {
        background: white;
        border-radius: 18px;
        padding: 3rem;
        text-align: center;
        color: #888;
        border: 1px dashed rgba(26,107,60,0.2);
    }

    /* ═══════════════════════════════════════════
       LIGHTBOX (zoom)
    ═══════════════════════════════════════════ */
    .lightbox-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.88);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(8px);
        padding: 2rem;
        cursor: zoom-out;
    }

        .lightbox-overlay.open {
            display: flex;
            animation: lbFadeIn 0.28s ease;
        }

    @@keyframes lbFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .lightbox-img {
        max-width: 90vw;
        max-height: 88vh;
        border-radius: 16px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.6);
        object-fit: contain;
        animation: lbZoomIn 0.3s cubic-bezier(.34,1.56,.64,1);
    }

    @@keyframes lbZoomIn {
        from {
            transform: scale(0.82);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .lightbox-close {
        position: fixed;
        top: 1.5rem;
        right: 1.8rem;
        width: 44px;
        height: 44px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 50%;
        color: white;
        font-size: 1.3rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        z-index: 10000;
        backdrop-filter: blur(6px);
    }

        .lightbox-close:hover {
            background: rgba(255,255,255,0.22);
            transform: rotate(90deg);
        }

    .lightbox-caption {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(8px);
        color: rgba(255,255,255,0.88);
        font-size: 0.88rem;
        font-weight: 600;
        padding: 0.55rem 1.4rem;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,0.12);
        white-space: nowrap;
        z-index: 10000;
    }

    /* ═══════════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════════ */
    footer {
        background: linear-gradient(180deg, #082818 0%, #0f4226 100%);
        color: rgba(255,255,255,0.8);
        text-align: center;
        padding: 3rem 2rem 2rem;
        position: relative;
    }

        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #c8993a, #e8b84b, #c8993a);
        }

    .footer-logo {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        color: white;
        font-weight: 900;
        margin-bottom: 0.4rem;
    }

    .footer-copy {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.38);
        margin-top: 0.8rem;
    }

    .footer-dev {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.28);
    }

        .footer-dev span {
            color: #e8b84b;
            font-weight: 700;
        }

    /* ═══════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════ */
    @@media (max-width: 900px) {
        .det-container {
            grid-template-columns: 1fr;
        }

        .det-sidebar {
            position: static;
        }

        .det-members-grid {
            grid-template-columns: 1fr 1fr;
        }

        .det-hero h1 {
            font-size: 1.9rem;
        }

        .det-back-btn {
            top: 72px;
        }

        .det-hero {
            padding: 110px 1.2rem 65px;
        }
    }

    @@media (max-width: 520px) {
        .det-members-grid {
            grid-template-columns: 1fr 1fr;
        }

        .det-hero-stats {
            gap: 1.2rem;
        }

        .dhs-sep {
            display: none;
        }
    }

    @@media (max-width: 380px) {
        .det-members-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- ═══ LIGHTBOX ═══ -->
<div class="lightbox-overlay" id="lightbox" onclick="closeLightbox(event)">
    <button class="lightbox-close" onclick="closeLightbox()">✕</button>
    <img class="lightbox-img" id="lightboxImg" src="" alt="" />
    <div class="lightbox-caption" id="lightboxCaption"></div>
</div>

<!-- ═══ HERO ═══ -->
<div class="det-hero">
    <a href="/#about" class="det-back-btn">← গ্রামের পাতায় ফিরুন</a>
    <span class="det-hero-icon">@Model.Icon</span>
    <div class="det-cat-tag">@Model.Category</div>
    <h1>@Model.Name</h1>
    <p class="det-hero-desc">@Model.Description</p>

    <div class="det-hero-stats">
        @if (!string.IsNullOrEmpty(Model.FoundedYear))
        {
            <div class="dhs-item">
                <span class="dhs-num">@Model.FoundedYear</span>
                <div class="dhs-label">প্রতিষ্ঠাকাল</div>
            </div>
            <div class="dhs-sep"></div>
        }
        <div class="dhs-item">
            <span class="dhs-num">@Model.Members.Count</span>
            <div class="dhs-label">মোট সদস্য</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.FounderName))
        {
            <div class="dhs-sep"></div>
            <div class="dhs-item">
                <span class="dhs-num" style="font-size:1rem;padding-top:0.3rem;">@Model.FounderName</span>
                <div class="dhs-label">প্রতিষ্ঠাতা</div>
            </div>
        }
    </div>
</div>

<!-- ═══ BODY ═══ -->
<div class="det-body">
    <div class="det-container">

        <!-- SIDEBAR -->
        <aside class="det-sidebar">

            <!-- Main Image (zoomable) -->
            <div class="det-img-box" onclick="openLightbox('@Model.ImagePath', '@Model.Name')">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Name" />
                    <div class="det-img-zoom-hint">🔍 বড় করে দেখুন</div>
                }
                else
                {
                    <div class="det-img-placeholder">
                        <span>@Model.Icon</span>
                    </div>
                }
            </div>

            <!-- Info Box -->
            <div class="det-info-box">
                <h3>📋 প্রতিষ্ঠানের তথ্য</h3>

                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <div class="det-info-row">
                        <div class="det-info-icon">🏷️</div>
                        <div class="det-info-text">
                            <strong>ধরন / বিভাগ</strong>
                            <span>@Model.Category</span>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.FoundedYear))
                {
                    <div class="det-info-row">
                        <div class="det-info-icon">📅</div>
                        <div class="det-info-text">
                            <strong>প্রতিষ্ঠাকাল</strong>
                            <span>@Model.FoundedYear</span>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.FounderName))
                {
                    <div class="det-info-row">
                        <div class="det-info-icon">👤</div>
                        <div class="det-info-text">
                            <strong>প্রতিষ্ঠাতা</strong>
                            <span>@Model.FounderName</span>
                        </div>
                    </div>
                }
                <div class="det-info-row">
                    <div class="det-info-icon">👥</div>
                    <div class="det-info-text">
                        <strong>মোট সদস্য</strong>
                        <span>@Model.Members.Count জন</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="det-main">

            @if (!string.IsNullOrEmpty(Model.Details) || !string.IsNullOrEmpty(Model.Description))
            {
                <div class="det-section-title">📖 বিস্তারিত বিবরণ</div>
                <div class="det-desc-box">
                    @Html.Raw((Model.Details ?? Model.Description).Replace("\n", "<br/>"))
                </div>
            }

            <!-- MEMBERS -->
            <div class="det-section-title">👥 সংশ্লিষ্ট ব্যক্তিবর্গ</div>

            @if (Model.Members.Any())
            {
                <div class="det-members-grid">
                    @foreach (var m in Model.Members)
                    {
                        <div class="det-member-card"
                             onclick="@(!string.IsNullOrEmpty(m.ImagePath) ? $"openLightbox('{m.ImagePath}', '{m.Name}')" : "void(0)")">
                            <div class="det-member-avatar">
                                @if (!string.IsNullOrEmpty(m.ImagePath))
                                {
                                    <img src="@m.ImagePath" alt="@m.Name" />
                                }
                                else
                                {
                                    @m.Avatar
                                }
                            </div>
                            <div class="det-member-name">@m.Name</div>
                            @if (!string.IsNullOrEmpty(m.Role))
                            {
                                <div class="det-member-role">@m.Role</div>
                            }
                            @if (!string.IsNullOrEmpty(m.Profession))
                            {
                                <div class="det-member-profession">💼 @m.Profession</div>
                            }
                            @if (!string.IsNullOrEmpty(m.Phone))
                            {
                                <div class="det-member-phone">📞 @m.Phone</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="det-no-members">
                    <div style="font-size:2.8rem;margin-bottom:0.9rem;">👥</div>
                    <p>এখনো কোনো সদস্যের তথ্য যোগ করা হয়নি।</p>
                </div>
            }
        </main>

    </div>
</div>

