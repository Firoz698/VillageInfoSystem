@model VillageInfoSystem.Models.News
@{
    ViewData["Title"] = Model.Title;
    var relatedNews = ViewBag.RelatedNews as List<VillageInfoSystem.Models.News>;
}

<style>
    /* ══════════════════════════════════════
           NEWS DETAILS PAGE
        ══════════════════════════════════════ */

    .nd-hero {
        background: linear-gradient(135deg, #082818 0%, #0d3520 50%, var(--green-dark) 100%);
        padding: 100px 0 60px;
        position: relative;
        overflow: hidden;
    }

        .nd-hero::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(45,155,90,0.12) 0%, transparent 65%);
            top: -200px;
            right: -150px;
            pointer-events: none;
        }

        .nd-hero::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(200,153,58,0.08) 0%, transparent 65%);
            bottom: -150px;
            left: -100px;
            pointer-events: none;
        }

    .nd-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: rgba(255,255,255,0.55);
        margin-bottom: 1.8rem;
        position: relative;
        z-index: 1;
    }

        .nd-breadcrumb a {
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            transition: color 0.2s;
        }

            .nd-breadcrumb a:hover {
                color: var(--gold-light);
            }

        .nd-breadcrumb span {
            color: rgba(255,255,255,0.3);
        }

    .nd-hero-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1.2rem;
        position: relative;
        z-index: 1;
    }

    .nd-cat-badge {
        background: rgba(200,153,58,0.18);
        color: var(--gold-light);
        border: 1px solid rgba(200,153,58,0.3);
        padding: 0.28rem 0.85rem;
        border-radius: 50px;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .nd-featured-badge {
        background: linear-gradient(135deg, var(--gold), var(--gold-light));
        color: var(--green-dark);
        padding: 0.28rem 0.85rem;
        border-radius: 50px;
        font-size: 0.76rem;
        font-weight: 800;
        box-shadow: 0 3px 12px rgba(200,153,58,0.4);
    }

    .nd-date {
        color: rgba(255,255,255,0.5);
        font-size: 0.82rem;
    }

    .nd-hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        font-weight: 900;
        color: white;
        line-height: 1.3;
        max-width: 750px;
        position: relative;
        z-index: 1;
    }

    /* ── Main Layout ── */
    .nd-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 2.5rem;
        align-items: start;
        padding: 3rem 0 5rem;
    }

    /* ── Article ── */
    .nd-article {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(26,107,60,0.08);
        box-shadow: 0 8px 40px rgba(26,107,60,0.07);
    }

    /* Hero image inside article */
    .nd-article-img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        display: block;
    }

    .nd-article-img-placeholder {
        width: 100%;
        height: 280px;
        background: linear-gradient(135deg, var(--green-dark), var(--green-light));
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        position: relative;
        overflow: hidden;
    }

        .nd-article-img-placeholder::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
        }

    .nd-placeholder-icon {
        font-size: 5rem;
        position: relative;
        z-index: 1;
    }

    .nd-placeholder-text {
        color: rgba(255,255,255,0.7);
        font-size: 0.9rem;
        font-weight: 600;
        position: relative;
        z-index: 1;
    }

    /* Article content */
    .nd-article-body {
        padding: 2.2rem 2.5rem 2.5rem;
    }

    .nd-article-desc {
        color: #3a4a3e;
        font-size: 1.05rem;
        line-height: 1.95;
        white-space: pre-line;
    }

    /* Share row */
    .nd-share-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 2.2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(26,107,60,0.08);
        flex-wrap: wrap;
    }

    .nd-share-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--green-dark);
        margin-right: 0.25rem;
    }

    .nd-share-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.42rem 1rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.22s;
        border: none;
        cursor: pointer;
    }

    .nd-share-fb {
        background: #1877f2;
        color: white;
    }

    .nd-share-wa {
        background: #25d366;
        color: white;
    }

    .nd-share-copy {
        background: rgba(26,107,60,0.08);
        color: var(--green);
        border: 1px solid rgba(26,107,60,0.15);
    }

    .nd-share-btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    /* Back button */
    .nd-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        color: var(--green);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        padding: 0.6rem 1.4rem;
        border: 2px solid rgba(26,107,60,0.2);
        border-radius: 50px;
        transition: all 0.22s;
    }

        .nd-back-btn:hover {
            background: var(--green);
            color: white;
            border-color: var(--green);
            transform: translateX(-3px);
        }

    /* ── Sidebar ── */
    .nd-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: sticky;
        top: 90px;
    }

    /* Info card */
    .nd-info-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid rgba(26,107,60,0.09);
        box-shadow: 0 4px 20px rgba(26,107,60,0.06);
    }

        .nd-info-card h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 800;
            color: var(--green-dark);
            margin-bottom: 1.1rem;
            padding-bottom: 0.7rem;
            border-bottom: 2px solid rgba(26,107,60,0.08);
        }

    .nd-info-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.9rem;
        font-size: 0.87rem;
    }

    .nd-info-icon {
        width: 34px;
        height: 34px;
        background: rgba(26,107,60,0.07);
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .nd-info-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--green);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.15rem;
    }

    .nd-info-val {
        color: var(--green-dark);
        font-weight: 600;
        font-size: 0.88rem;
    }

    /* Related news card */
    .nd-related-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(26,107,60,0.09);
        box-shadow: 0 4px 20px rgba(26,107,60,0.06);
    }

    .nd-related-head {
        padding: 1rem 1.3rem;
        background: #f5f9f5;
        border-bottom: 1px solid rgba(26,107,60,0.08);
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--green-dark);
    }

    /* Related news item */
    a.nd-rel-item {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid rgba(26,107,60,0.06);
        text-decoration: none;
        color: inherit;
        transition: all 0.22s;
    }

        a.nd-rel-item:last-child {
            border-bottom: none;
        }

        a.nd-rel-item:hover {
            background: #f3fbf5;
            padding-left: 1.4rem;
        }

    .nd-rel-thumb {
        width: 56px;
        height: 56px;
        border-radius: 10px;
        overflow: hidden;
        flex-shrink: 0;
        border: 1px solid rgba(26,107,60,0.1);
    }

        .nd-rel-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .nd-rel-icon {
        width: 48px;
        height: 48px;
        background: #f0f8f2;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .nd-rel-title {
        font-size: 0.86rem;
        font-weight: 700;
        color: var(--green-dark);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 0.25rem;
    }

    .nd-rel-date {
        font-size: 0.73rem;
        color: var(--text-light);
    }

    /* ── Responsive ── */
    @@media (max-width: 960px) {
        .nd-layout {
            grid-template-columns: 1fr;
        }

        .nd-sidebar {
            position: static;
        }

        .nd-hero-title {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 580px) {
        .nd-hero {
            padding: 90px 0 40px;
        }

        .nd-hero-title {
            font-size: 1.45rem;
        }

        .nd-article-body {
            padding: 1.4rem 1.3rem 1.8rem;
        }

        .nd-article-img {
            height: 220px;
        }
    }
</style>

<!-- ═══ HERO ═══ -->
<div class="nd-hero">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="nd-breadcrumb">
            <a href="/">🏠 হোম</a>
            <span>›</span>
            <a href="/#news">সংবাদ</a>
            <span>›</span>
            <span style="color:rgba(255,255,255,0.75);">@Model.Title</span>
        </div>

        <!-- Meta -->
        <div class="nd-hero-meta">
            <span class="nd-cat-badge">@Model.Icon @Model.Category</span>
            @if (Model.IsFeatured)
            {
                <span class="nd-featured-badge">⭐ শীর্ষ সংবাদ</span>
            }
            <span class="nd-date">📅 @Model.PublishedAt.ToString("dd MMMM, yyyy")</span>
        </div>

        <!-- Title -->
        <h1 class="nd-hero-title">@Model.Title</h1>
    </div>
</div>

<!-- ═══ MAIN CONTENT ═══ -->
<div style="background:#f5f9f6;">
    <div class="container">
        <div class="nd-layout">

            <!-- ── Article ── -->
            <article class="nd-article">

                @* Image or Placeholder *@
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="@Model.Title" class="nd-article-img" />
                }
                else
                {
                    <div class="nd-article-img-placeholder">
                        <div class="nd-placeholder-icon">@Model.Icon</div>
                        <div class="nd-placeholder-text">@Model.Category</div>
                    </div>
                }

                <div class="nd-article-body">
                    @* Description / Content *@
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="nd-article-desc">@Model.Description</div>
                    }
                    else
                    {
                        <p style="color:var(--text-light);font-style:italic;">এই সংবাদের বিস্তারিত বিবরণ এখনো যোগ করা হয়নি।</p>
                    }

                    <!-- Share Row -->
                    <div class="nd-share-row">
                        <span class="nd-share-label">🔗 শেয়ার করুন:</span>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@(Uri.EscapeDataString(Context.Request.Path))"
                           target="_blank" class="nd-share-btn nd-share-fb">
                            📘 Facebook
                        </a>
                        <a href="https://wa.me/?text=@(Uri.EscapeDataString(Model.Title + " " + Context.Request.Path))"
                           target="_blank" class="nd-share-btn nd-share-wa">
                            💬 WhatsApp
                        </a>
                        <button class="nd-share-btn nd-share-copy" onclick="copyLink()">
                            📋 লিংক কপি
                        </button>
                    </div>

                    <!-- Back Button -->
                    <a href="javascript:history.back()" class="nd-back-btn">← ফিরে যান</a>
                </div>
            </article>

            <!-- ── Sidebar ── -->
            <aside class="nd-sidebar">

                <!-- News Info Card -->
                <div class="nd-info-card">
                    <h4>📌 সংবাদ তথ্য</h4>
                    <div class="nd-info-row">
                        <div class="nd-info-icon">📅</div>
                        <div>
                            <div class="nd-info-label">প্রকাশের তারিখ</div>
                            <div class="nd-info-val">@Model.PublishedAt.ToString("dd MMMM, yyyy")</div>
                        </div>
                    </div>
                    <div class="nd-info-row">
                        <div class="nd-info-icon">🏷️</div>
                        <div>
                            <div class="nd-info-label">বিভাগ</div>
                            <div class="nd-info-val">@Model.Category</div>
                        </div>
                    </div>
                    <div class="nd-info-row">
                        <div class="nd-info-icon">@Model.Icon</div>
                        <div>
                            <div class="nd-info-label">ধরন</div>
                            <div class="nd-info-val">@(Model.IsFeatured ? "শীর্ষ সংবাদ" : "সাধারণ সংবাদ")</div>
                        </div>
                    </div>
                </div>

                <!-- Related News -->
                @if (relatedNews != null && relatedNews.Any())
                {
                    <div class="nd-related-card">
                        <div class="nd-related-head">📰 সম্পর্কিত সংবাদ</div>
                        @foreach (var r in relatedNews)
                        {
                            <a href="/Home/NewsDetails/@r.Id" class="nd-rel-item">
                                @if (!string.IsNullOrEmpty(r.ImagePath))
                                {
                                    <div class="nd-rel-thumb">
                                        <img src="@r.ImagePath" alt="@r.Title" loading="lazy" />
                                    </div>
                                }
                                else
                                {
                                    <div class="nd-rel-icon">@r.Icon</div>
                                }
                                <div>
                                    <div class="nd-rel-title">@r.Title</div>
                                    <div class="nd-rel-date">📅 @r.PublishedAt.ToString("dd MMM, yyyy")</div>
                                </div>
                            </a>
                        }
                    </div>
                }

                <!-- Back to all news -->
                <a href="/#news" style="display:flex;align-items:center;justify-content:center;gap:0.5rem;
                    background:linear-gradient(135deg,var(--green),var(--green-light));
                    color:white;padding:0.85rem 1.5rem;border-radius:14px;font-weight:700;
                    font-size:0.9rem;text-decoration:none;
                    box-shadow:0 6px 20px rgba(26,107,60,0.25);
                    transition:all 0.25s;">
                    📋 সব সংবাদ দেখুন
                </a>
            </aside>
        </div>
    </div>
</div>

<script>
    function copyLink() {
        navigator.clipboard.writeText(window.location.href).then(() => {
            const btn = document.querySelector('.nd-share-copy');
            const orig = btn.innerHTML;
            btn.innerHTML = '✅ কপি হয়েছে!';
            btn.style.background = 'rgba(26,107,60,0.15)';
            setTimeout(() => {
                btn.innerHTML = orig;
                btn.style.background = '';
            }, 2000);
        });
    }
</script>
