<script>
    // ── Image upload ──
    function handleFileSelect(input) {
        if (input.files && input.files[0]) showNewPreview(input.files[0]);
    }

    function handleDragOver(e) { e.preventDefault(); document.getElementById('uploadArea').classList.add('drag-over'); }
    function handleDragLeave(e) { document.getElementById('uploadArea').classList.remove('drag-over'); }

    function handleDrop(e) {
        e.preventDefault();
        document.getElementById('uploadArea').classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            const dt = new DataTransfer();
            dt.items.add(file);
            document.getElementById('imageFileInput').files = dt.files;
            showNewPreview(file);
        }
    }

    function showNewPreview(file) {
        if (file.size > 5 * 1024 * 1024) { alert('ছবির আকার ৫ MB এর বেশি হতে পারবে না।'); return; }
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('newImgPreviewImg').src = e.target.result;
            document.getElementById('newImgPreviewWrap').style.display = 'block';
            document.getElementById('uploadAreaWrap').style.display = 'none';
            document.getElementById('newImgFileName').textContent = '📎 ' + file.name;
            // sidebar preview
            const prevImg = document.getElementById('prevImage');
            prevImg.src = e.target.result;
            prevImg.style.display = 'block';
            document.getElementById('prevIcon').style.display = 'none';
        };
        reader.readAsDataURL(file);
    }

    function removeNewImage() {
        document.getElementById('imageFileInput').value = '';
        document.getElementById('newImgPreviewWrap').style.display = 'none';
        document.getElementById('uploadAreaWrap').style.display = 'block';
        // sidebar: পুরনো ছবিতে ফিরে যাও
        const currentSrc = document.getElementById('currentImgEl')?.src;
        const prevImg = document.getElementById('prevImage');
        if (currentSrc) {
            prevImg.src = currentSrc;
            prevImg.style.display = 'block';
            document.getElementById('prevIcon').style.display = 'none';
        } else {
            prevImg.style.display = 'none';
            document.getElementById('prevIcon').style.display = 'block';
        }
    }

    // ── Form helpers ──
    function updateTitleCounter() {
        const v = document.getElementById('titleInput').value.length;
        const el = document.getElementById('titleCounter');
        el.textContent = v + '/১০০';
        el.className = 'char-counter' + (v > 90 ? ' warn' : '');
    }

    function updateDescCounter() {
        document.getElementById('descCounter').textContent =
            document.getElementById('descInput').value.length;
    }

    function updatePreview() {
        const title = document.getElementById('titleInput')?.value || 'শিরোনাম';
        const desc  = document.getElementById('descInput')?.value  || 'বিবরণ...';
        const icon  = document.getElementById('iconInput')?.value  || '📰';
        const cat   = document.getElementById('catSelect')?.value  || 'সাধারণ';
        document.getElementById('prevTitle').textContent = title.substring(0, 60);
        document.getElementById('prevDesc').textContent  = desc.substring(0, 80);
        document.getElementById('prevIcon').textContent  = icon || '📰';
        document.getElementById('prevCat').textContent   = cat;
    }

    function selectIcon(icon) {
        document.getElementById('iconInput').value = icon;
        document.querySelectorAll('.icon-option').forEach(el =>
            el.classList.toggle('selected', el.textContent.trim() === icon));
        updatePreview();
    }

    function selectCat(cat) { document.getElementById('catSelect').value = cat; syncCatPills(); updatePreview(); }

    function syncCatPills() {
        const cat = document.getElementById('catSelect').value;
        document.querySelectorAll('.cat-pill').forEach(el =>
            el.classList.toggle('selected', el.textContent === cat));
    }

    function syncToggleStyle(wrapId, inputId) {
        document.getElementById(wrapId).classList.toggle('checked',
            document.getElementById(inputId).checked);
    }

    window.addEventListener('DOMContentLoaded', () => {
        syncCatPills(); updatePreview();
        updateTitleCounter(); updateDescCounter();
        const curIcon = document.getElementById('iconInput')?.value;
        if (curIcon) {
            document.querySelectorAll('.icon-option').forEach(el => {
                if (el.textContent.trim() === curIcon.trim()) el.classList.add('selected');
            });
        }
    });
</script>