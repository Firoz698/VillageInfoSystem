@model List<VillageInfoSystem.Models.News>
@{
    ViewData["Title"] = "সংবাদ ব্যবস্থাপনা";
    Layout = "_AdminLayout";
    int activeCount = Model.Count(n => n.IsActive);
    int featuredCount = Model.Count(n => n.IsFeatured);
    int withImageCount = Model.Count(n => !string.IsNullOrEmpty(n.ImagePath));
}

<style>
   @@import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Playfair+Display:wght@700;900&display=swap');

    :root {
        --forest: #0d5c2e;
        --emerald: #1a8a4a;
        --jade: #2ebd6b;
        --mint: #d4f7e2;
        --gold: #d4a017;
        --amber: #f0c040;
        --sand: #fef3d0;
        --sky: #1565c0;
        --azure: #4090e8;
        --ice: #dbeeff;
        --violet: #6a1fa2;
        --lilac: #f0e5ff;
        --coral: #c0392b;
        --blush: #ffe0e0;
        --bg: #f0f4f0;
        --surface: #ffffff;
        --border: #e0ebe2;
        --text: #1a2e1f;
        --muted: #6b8070;
        --radius: 16px;
        --shadow: 0 4px 24px rgba(13,92,46,0.08);
        --shadow-lg: 0 12px 48px rgba(13,92,46,0.16);
    }

    /* ══ PAGE HEADER ══ */
    .page-header {
        position: relative;
        border-radius: 24px;
        padding: 2rem 2.4rem;
        margin-bottom: 1.6rem;
        overflow: hidden;
        background: linear-gradient(135deg, #0d5c2e 0%, #1a8a4a 45%, #2ebd6b 100%);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem;
        flex-wrap: wrap;
        box-shadow: 0 14px 44px rgba(13,92,46,0.32);
        animation: fadeUp 0.45s ease both;
    }

        .page-header::before {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,0.07) 0%, transparent 70%);
            top: -140px;
            right: -60px;
            pointer-events: none;
        }

        .page-header::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
            background-size: 26px 26px;
            pointer-events: none;
        }

    .ph-text {
        position: relative;
        z-index: 2;
    }

        .ph-text h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.55rem;
            font-weight: 900;
            color: #fff;
            margin-bottom: 0.3rem;
            text-shadow: 0 2px 8px rgba(0,0,0,0.18);
        }

        .ph-text p {
            font-size: 0.86rem;
            color: rgba(255,255,255,0.68);
        }

    .ph-btn {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.4rem;
        background: rgba(255,255,255,0.18);
        border: 1.5px solid rgba(255,255,255,0.35);
        border-radius: 50px;
        color: #fff;
        font-weight: 700;
        font-size: 0.88rem;
        text-decoration: none;
        font-family: 'Hind Siliguri', sans-serif;
        backdrop-filter: blur(6px);
        transition: all 0.22s;
        white-space: nowrap;
    }

        .ph-btn:hover {
            background: rgba(255,255,255,0.28);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.18);
            color: #fff;
            text-decoration: none;
        }

    /* ══ STAT PILLS ══ */
    .news-stats {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.4rem;
        flex-wrap: wrap;
        animation: fadeUp 0.45s 0.08s ease both;
    }

    .ns-pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.1rem;
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: 50px;
        font-size: 0.8rem;
        color: var(--muted);
        box-shadow: var(--shadow);
        white-space: nowrap;
        font-weight: 500;
        transition: transform 0.2s;
    }

        .ns-pill:hover {
            transform: translateY(-2px);
        }

        .ns-pill strong {
            color: var(--forest);
            font-size: 0.95rem;
            font-weight: 800;
        }

        .ns-pill.pill-green {
            border-color: #c6e8d2;
            background: #edfaf2;
        }

        .ns-pill.pill-gold {
            border-color: #f0dfa0;
            background: #fffae8;
        }

        .ns-pill.pill-blue {
            border-color: #b8d8f8;
            background: #eaf4ff;
        }

        .ns-pill.pill-violet {
            border-color: #dcc8f5;
            background: #f5eeff;
        }

        .ns-pill.pill-red {
            border-color: #f0b8b8;
            background: #fff5f5;
        }

        .ns-pill.pill-green strong {
            color: var(--forest);
        }

        .ns-pill.pill-gold strong {
            color: #7a5010;
        }

        .ns-pill.pill-blue strong {
            color: var(--sky);
        }

        .ns-pill.pill-violet strong {
            color: var(--violet);
        }

        .ns-pill.pill-red strong {
            color: var(--coral);
        }

    /* ══ FILTER BAR ══ */
    .filter-bar {
        background: var(--surface);
        border-radius: 16px;
        border: 1.5px solid var(--border);
        padding: 0.85rem 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin-bottom: 1.3rem;
        flex-wrap: wrap;
        box-shadow: var(--shadow);
        animation: fadeUp 0.45s 0.14s ease both;
    }

    .search-wrap {
        flex: 1;
        min-width: 160px;
        position: relative;
    }

        .search-wrap input {
            width: 100%;
            padding: 0.58rem 0.9rem 0.58rem 2.3rem;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-family: 'Hind Siliguri', sans-serif;
            font-size: 0.86rem;
            transition: all 0.22s;
            background: #f8fbf8;
            color: var(--text);
        }

            .search-wrap input:focus {
                outline: none;
                border-color: var(--emerald);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(26,138,74,0.1);
            }

    .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.82rem;
        pointer-events: none;
    }

    .filter-select {
        padding: 0.58rem 0.9rem;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-family: 'Hind Siliguri', sans-serif;
        font-size: 0.83rem;
        color: var(--text);
        cursor: pointer;
        background: #f8fbf8;
        flex-shrink: 0;
        transition: all 0.22s;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--emerald);
            background: #fff;
        }

    /* ══ TABLE CARD ══ */
    .table-card {
        background: var(--surface);
        border-radius: 20px;
        border: 1.5px solid var(--border);
        box-shadow: var(--shadow);
        overflow: hidden;
        animation: fadeUp 0.45s 0.2s ease both;
    }

    .tc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.5rem;
        border-bottom: 1.5px solid var(--border);
        background: linear-gradient(90deg, #f5fbf7, #fff);
        flex-wrap: wrap;
        gap: 0.7rem;
    }

    .tc-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        color: var(--forest);
        font-size: 0.97rem;
    }

    .tc-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--mint);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
    }

    /* ══ BADGES ══ */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        padding: 0.28rem 0.72rem;
        border-radius: 50px;
        font-size: 0.73rem;
        font-weight: 700;
    }

    .badge-green {
        background: var(--mint);
        color: var(--forest);
        border: 1px solid #b0e0c0;
    }

    .badge-gold {
        background: var(--sand);
        color: #7a5010;
        border: 1px solid #f0dfa0;
    }

    .badge-blue {
        background: var(--ice);
        color: var(--sky);
        border: 1px solid #b8d8f8;
    }

    .badge-success {
        background: #e2f9ec;
        color: #0d7a3e;
        border: 1px solid #9ae0b8;
    }

    .badge-danger {
        background: var(--blush);
        color: var(--coral);
        border: 1px solid #f0b8b8;
    }

    /* ══ DESKTOP TABLE ══ */
    .table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.86rem;
    }

    thead th {
        background: #f5fbf7;
        color: var(--forest);
        padding: 0.75rem 1rem;
        text-align: left;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid var(--border);
        white-space: nowrap;
    }

    tbody td {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #f0f6f1;
        vertical-align: middle;
        color: var(--text);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: linear-gradient(90deg, #f7fdf9, #fff);
    }

    tbody tr.filtered-out {
        display: none;
    }

    .news-thumb {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        object-fit: cover;
        display: block;
        border: 1.5px solid #d0e8d8;
    }

    .news-thumb-placeholder {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        background: #f0f7f2;
        border: 1.5px dashed #b8d8c0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: #90b898;
    }

    .news-icon-cell {
        font-size: 1.45rem;
        line-height: 1;
    }

    .news-title-cell {
        max-width: 220px;
    }

    .news-title-text {
        font-weight: 600;
        color: var(--text);
        font-size: 0.86rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .news-title-desc {
        font-size: 0.73rem;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin-top: 2px;
    }

    .actions-cell {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        white-space: nowrap;
    }

    /* ══ BUTTONS ══ */
    .btn-sm {
        padding: 0.38rem 0.85rem;
        border-radius: 50px;
        font-size: 0.77rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        transition: all 0.2s;
        font-family: 'Hind Siliguri', sans-serif;
        border: none;
        cursor: pointer;
        line-height: 1.5;
    }

    .btn-edit {
        background: var(--ice);
        color: var(--sky);
        border: 1.5px solid #b8d8f8;
    }

        .btn-edit:hover {
            background: var(--sky);
            color: #fff;
            text-decoration: none;
            border-color: var(--sky);
        }

    .btn-danger {
        background: var(--blush);
        color: var(--coral);
        border: 1.5px solid #f0b8b8;
    }

        .btn-danger:hover {
            background: var(--coral);
            color: #fff;
            border-color: var(--coral);
        }

    /* ══ EMPTY STATE ══ */
    .empty-state {
        text-align: center;
        padding: 4rem 1.5rem;
        color: var(--muted);
    }

        .empty-state .es-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: 0.8rem;
            opacity: 0.4;
        }

        .empty-state p {
            font-size: 0.9rem;
        }

    /* ══ MOBILE CARDS ══ */
    .desktop-table {
        display: block;
    }

    .mobile-list {
        display: none;
    }

    .m-news-card {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        transition: background 0.15s;
    }

        .m-news-card:last-child {
            border-bottom: none;
        }

        .m-news-card:hover {
            background: #f7fdf9;
        }

    .m-thumb {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
        border: 1.5px solid #d0e8d8;
    }

    .m-thumb-placeholder {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        background: #f0f7f2;
        border: 1.5px dashed #b8d8c0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .m-body {
        flex: 1;
        min-width: 0;
    }

    .m-title {
        font-weight: 700;
        color: var(--text);
        font-size: 0.9rem;
        line-height: 1.4;
        margin-bottom: 0.35rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .m-meta {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
        margin-bottom: 0.55rem;
    }

    .m-date {
        font-size: 0.73rem;
        color: var(--muted);
    }

    .m-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .m-badges {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
    }

    .m-actions {
        display: flex;
        gap: 0.35rem;
        align-items: center;
        flex-shrink: 0;
    }

    /* ══ ANIMATIONS ══ */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ══ RESPONSIVE ══ */
    @@media (max-width: 860px) {
        .hide-tablet {
            display: none;
        }
    }

    @@media (max-width: 640px) {
        .desktop-table {
            display: none !important;
        }

        .mobile-list {
            display: block !important;
        }

        .filter-bar {
            flex-direction: column;
            gap: 0.5rem;
        }

        .search-wrap {
            min-width: unset;
        }

        .filter-select {
            width: 100%;
        }

        .ph-text h2 {
            font-size: 1.2rem;
        }

        .page-header {
            padding: 1.5rem 1.3rem;
        }
    }

    @@media (max-width: 400px) {
        .m-news-card {
            padding: 0.8rem 0.9rem;
        }

        .m-thumb, .m-thumb-placeholder {
            width: 46px;
            height: 46px;
        }

        .m-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .news-stats {
            gap: 0.4rem;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <div class="ph-text">
        <h2>📰 সংবাদ ব্যবস্থাপনা</h2>
        <p>গ্রামের সকল সংবাদ পরিচালনা করুন</p>
    </div>
    <a href="/News/NewsCreate" class="ph-btn">➕ নতুন সংবাদ</a>
</div>

<!-- ── STAT PILLS ── -->
@if (Model.Any())
{
    <div class="news-stats">
        <div class="ns-pill pill-green">📰 মোট <strong>@Model.Count</strong> টি</div>
        <div class="ns-pill pill-green">✅ সক্রিয় <strong>@activeCount</strong></div>
        <div class="ns-pill pill-gold">⭐ শীর্ষ <strong>@featuredCount</strong></div>
        <div class="ns-pill pill-blue">🖼️ ছবি সহ <strong>@withImageCount</strong></div>
        @if (Model.Count - activeCount > 0)
        {
            <div class="ns-pill pill-red">⏸️ নিষ্ক্রিয় <strong>@(Model.Count - activeCount)</strong></div>
        }
    </div>
}

<!-- ── FILTER BAR ── -->
<div class="filter-bar">
    <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="searchInput" placeholder="সংবাদ খুঁজুন..." oninput="filterTable()" />
    </div>
    <select class="filter-select" id="catFilter" onchange="filterTable()">
        <option value="">সব বিভাগ</option>
        <option>সাধারণ</option>
        <option>শিক্ষা</option>
        <option>উন্নয়ন</option>
        <option>কৃষি</option>
        <option>স্বাস্থ্য</option>
        <option>ধর্মীয়</option>
        <option>খেলাধুলা</option>
        <option>সংস্কৃতি</option>
    </select>
    <select class="filter-select" id="statusFilter" onchange="filterTable()">
        <option value="">সব অবস্থা</option>
        <option value="active">সক্রিয়</option>
        <option value="inactive">নিষ্ক্রিয়</option>
        <option value="featured">শীর্ষ সংবাদ</option>
        <option value="hasimage">ছবি আছে</option>
        <option value="noimage">ছবি নেই</option>
    </select>
</div>

<!-- ── TABLE CARD ── -->
<div class="table-card">
    <div class="tc-header">
        <div class="tc-title">
            <div class="tc-icon">📋</div>
            সকল সংবাদ
            <span class="badge badge-green" id="visibleCount">@Model.Count টি</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="es-icon">📭</span>
            <p>এখনো কোনো সংবাদ যোগ করা হয়নি।</p>
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="table-wrap desktop-table">
            <table id="newsTable">
                <thead>
                    <tr>
                        <th style="width:54px">ছবি</th>
                        <th style="width:44px">আইকন</th>
                        <th>শিরোনাম</th>
                        <th class="hide-tablet">বিভাগ</th>
                        <th class="hide-tablet">তারিখ</th>
                        <th style="width:52px">শীর্ষ</th>
                        <th>অবস্থা</th>
                        <th style="width:160px">কার্যক্রম</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var n in Model)
                    {
                        <tr data-title="@n.Title.ToLower()"
                            data-cat="@n.Category"
                            data-active="@n.IsActive.ToString().ToLower()"
                            data-featured="@n.IsFeatured.ToString().ToLower()"
                            data-hasimage="@(!string.IsNullOrEmpty(n.ImagePath) ? "true" : "false")">

                            <td>
                                @if (!string.IsNullOrEmpty(n.ImagePath))
                                {
                                    <img src="@n.ImagePath" alt="@n.Title" class="news-thumb" loading="lazy" />
                                }
                                else
                                {
                                    <div class="news-thumb-placeholder">📷</div>
                                }
                            </td>

                            <td><div class="news-icon-cell">@n.Icon</div></td>

                            <td class="news-title-cell">
                                <span class="news-title-text" title="@n.Title">@n.Title</span>
                                @if (!string.IsNullOrEmpty(n.Description))
                                {
                                    <span class="news-title-desc">@(n.Description.Length > 55 ? n.Description.Substring(0, 55) + "…" : n.Description)</span>
                                }
                            </td>

                            <td class="hide-tablet">
                                <span class="badge badge-gold">@n.Category</span>
                            </td>

                            <td class="hide-tablet" style="color:var(--muted);font-size:0.78rem;white-space:nowrap;">
                                @n.PublishedAt.ToString("dd MMM yyyy")
                            </td>

                            <td style="text-align:center">
                                @if (n.IsFeatured)
                                {
                                    <text>⭐</text>
                                }
                                else
                                {

                                    <span style="color:#ccc">—</span>
                                }
                            </td>

                            <td>
                                <span class="badge @(n.IsActive ? "badge-success" : "badge-danger")">
                                    @(n.IsActive ? "✓ সক্রিয়" : "✗ নিষ্ক্রিয়")
                                </span>
                            </td>

                            <td>
                                <div class="actions-cell">
                                    <a href="/News/NewsEdit/@n.Id" class="btn-sm btn-edit">✏️ সম্পাদনা</a>
                                    <form method="post" action="/News/NewsDelete/@n.Id" style="display:inline"
                                          onsubmit="return confirm('এই সংবাদ মুছে ফেলবেন?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-sm btn-danger">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards -->
        <div class="mobile-list" id="mobileList">
            @foreach (var n in Model)
            {
                <div class="m-news-card"
                     data-title="@n.Title.ToLower()"
                     data-cat="@n.Category"
                     data-active="@n.IsActive.ToString().ToLower()"
                     data-featured="@n.IsFeatured.ToString().ToLower()"
                     data-hasimage="@(!string.IsNullOrEmpty(n.ImagePath) ? "true" : "false")">

                    @if (!string.IsNullOrEmpty(n.ImagePath))
                    {
                        <img src="@n.ImagePath" alt="@n.Title" class="m-thumb" loading="lazy" />
                    }
                    else
                    {
                        <div class="m-thumb-placeholder">@n.Icon</div>
                    }

                    <div class="m-body">
                        <div class="m-title">@n.Title</div>
                        <div class="m-meta">
                            <span class="badge badge-gold">@n.Category</span>
                            <span class="m-date">📅 @n.PublishedAt.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="m-footer">
                            <div class="m-badges">
                                <span class="badge @(n.IsActive ? "badge-success" : "badge-danger")">
                                    @(n.IsActive ? "✓ সক্রিয়" : "✗ নিষ্ক্রিয়")
                                </span>
                                @if (n.IsFeatured)
                                {
                                    <span class="badge badge-gold">⭐ শীর্ষ</span>
                                }
                            </div>
                            <div class="m-actions">
                                <a href="/News/NewsEdit/@n.Id" class="btn-sm btn-edit">✏️</a>
                                <form method="post" action="/News/NewsDelete/@n.Id" style="display:inline"
                                      onsubmit="return confirm('এই সংবাদ মুছে ফেলবেন?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-sm btn-danger">🗑️</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const cat    = document.getElementById('catFilter').value;
        const status = document.getElementById('statusFilter').value;

        const isMobile = window.getComputedStyle(
            document.querySelector('.mobile-list')
        ).display !== 'none';

        const rows  = document.querySelectorAll('#tableBody tr');
        const cards = document.querySelectorAll('#mobileList .m-news-card');

        let visible = 0;

        function matches(el) {
            const titleMatch = !search || el.dataset.title.includes(search);
            const catMatch   = !cat    || el.dataset.cat === cat;
            let statusMatch  = true;
            if      (status === 'active')   statusMatch = el.dataset.active   === 'true';
            else if (status === 'inactive') statusMatch = el.dataset.active   === 'false';
            else if (status === 'featured') statusMatch = el.dataset.featured === 'true';
            else if (status === 'hasimage') statusMatch = el.dataset.hasimage === 'true';
            else if (status === 'noimage')  statusMatch = el.dataset.hasimage === 'false';
            return titleMatch && catMatch && statusMatch;
        }

        rows.forEach(r => {
            const show = matches(r);
            r.classList.toggle('filtered-out', !show);
            if (show && !isMobile) visible++;
        });

        cards.forEach(c => {
            const show = matches(c);
            c.style.display = show ? 'flex' : 'none';
            if (show && isMobile) visible++;
        });

        const vc = document.getElementById('visibleCount');
        if (vc) vc.textContent = visible + ' টি';
    }
</script>
