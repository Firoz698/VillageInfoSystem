@model VillageInfoSystem.Models.Fund.User
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "নতুন সদস্য";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>👤 নতুন সদস্য যোগ করুন</h2>
        <p>তহবিলের নতুন সদস্যের তথ্য দিন</p>
    </div>
    <a href="/User/UserList" class="btn btn-outline">← ফিরে যান</a>
</div>

<div class="card">
    <form method="post" enctype="multipart/form-data" action="/User/UserCreate">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">👤 পূর্ণ নাম *</label>
                <input name="Name" class="form-control" placeholder="সদস্যের নাম" required />
            </div>
            <div class="form-group">
                <label class="form-label">📞 ফোন নম্বর *</label>
                <input name="Phone" class="form-control" placeholder="01XXXXXXXXX" required />
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">📍 ঠিকানা</label>
            <input name="Address" class="form-control" placeholder="ঠিকানা লিখুন" />
        </div>
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">📅 যোগদানের তারিখ</label>
                <input name="JoinDate" type="date" class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label class="form-label">🖼️ প্রোফাইল ছবি</label>
                <input name="profileImage" type="file" class="form-control" accept="image/*" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">✅ সদস্য যোগ করুন</button>
    </form>
</div>