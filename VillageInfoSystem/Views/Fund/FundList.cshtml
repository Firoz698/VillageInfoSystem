@using VillageInfoSystem.Models.Fund
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "ফান্ড এন্ট্রি";
    var list = ViewBag.FundList as List<Fund>;
}

<div class="page-header">
    <div class="page-header-left">
        <h2>💵 ফান্ড এন্ট্রি তালিকা</h2>
        <p>সকল চাঁদার রেকর্ড</p>
    </div>
    <a href="/Fund/FundCreate" class="btn btn-primary">➕ নতুন এন্ট্রি</a>
</div>

@{
    var totalFund = ViewBag.TotalFund as decimal? ?? 0m;
}
<div class="stats-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:1.4rem;">
    <div class="stat-card">
        <div class="stat-icon-wrap green">💵</div>
        <div>
            <div class="stat-num">৳ @totalFund.ToString("N0")</div>
            <div class="stat-label">মোট সংগৃহীত</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-wrap gold">📋</div>
        <div>
            <div class="stat-num">@(list?.Count ?? 0)</div>
            <div class="stat-label">মোট এন্ট্রি</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-wrap blue">👥</div>
        <div>
            <div class="stat-num">@(list?.Select(f => f.UserId).Distinct().Count() ?? 0)</div>
            <div class="stat-label">সক্রিয় সদস্য</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>সদস্য</th>
                    <th>পরিমাণ</th>
                    <th>তারিখ</th>
                    <th>নোট</th>
                    <th>রসিদ</th>
                    <th>অ্যাকশন</th>
                </tr>
            </thead>
            <tbody>
                @if (list != null && list.Any())
                {
                    int i = 1;
                    foreach (var f in list)
                    {
                        <tr>
                            <td class="text-muted">@i</td>
                            <td><strong>@(f.User?.Name ?? "—")</strong></td>
                            <td><span class="badge badge-success">৳ @f.Amount.ToString("N0")</span></td>
                            <td class="text-muted">@f.Date.ToString("dd MMM, yyyy")</td>
                            <td class="text-muted">@(f.PaymentNote ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(f.PaymentImage))
                                {
                                    <a href="@f.PaymentImage" target="_blank">
                                        <img src="@f.PaymentImage" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid var(--border);" />
                                    </a>
                                }
                                else
                                {

                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="actions-wrap">
                                    <a href="/Fund/FundEdit/@f.Id" class="btn btn-edit btn-sm">✏️</a>
                                    <form method="post" action="/Fund/FundDelete/@f.Id"
                                          onsubmit="return confirm('মুছে ফেলবেন?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-danger btn-sm" type="submit">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted" style="padding:2.5rem;">কোনো এন্ট্রি নেই</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>