@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "নতুন ফান্ড এন্ট্রি";
    var users = ViewBag.Users as List<VillageInfoSystem.Models.Fund.User>;
}

<div class="page-header">
    <div class="page-header-left">
        <h2>💵 নতুন ফান্ড এন্ট্রি</h2>
        <p>চাঁদার নতুন রেকর্ড যোগ করুন</p>
    </div>
    <a href="/Fund/FundList" class="btn btn-outline">← ফিরে যান</a>
</div>

<div class="card">
    <form method="post" enctype="multipart/form-data" action="/Fund/FundCreate">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">👤 সদস্য *</label>
                <select name="UserId" class="form-control" required>
                    <option value="">— সদস্য বেছে নিন —</option>
                    @if (users != null)
                    {
                        foreach (var u in users)
                        {
                            <option value="@u.Id">@u.Name (@u.Phone)</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">💰 পরিমাণ (টাকা) *</label>
                <input name="Amount" type="number" step="0.01" min="1"
                       class="form-control" placeholder="০.০০" required />
            </div>
        </div>
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">📅 তারিখ *</label>
                <input name="Date" type="date" class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="form-group">
                <label class="form-label">🖼️ পেমেন্ট রসিদ</label>
                <input name="paymentImage" type="file" class="form-control" accept="image/*" />
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">📝 পেমেন্ট নোট</label>
            <textarea name="PaymentNote" class="form-control" rows="3"
                      placeholder="যেকোনো মন্তব্য বা রেফারেন্স..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">✅ এন্ট্রি যোগ করুন</button>
    </form>
</div>