@model List<VillageInfoSystem.Models.Institution>
@{
    ViewData["Title"] = "প্রতিষ্ঠান তালিকা";
    Layout = "_AdminLayout";
    int activeCount = Model.Count(i => i.IsActive);
}

<style>
    .inst-stats {
        display: flex;
        gap: 0.9rem;
        margin-bottom: 1.4rem;
        flex-wrap: wrap;
    }

    .is-pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.52rem 1rem;
        background: white;
        border: 1px solid var(--border);
        border-radius: 50px;
        font-size: 0.82rem;
        color: var(--text-muted);
        box-shadow: var(--shadow-sm);
    }

        .is-pill strong {
            color: var(--green-dark);
            font-size: 0.97rem;
            font-weight: 800;
        }

    .empty-box {
        background: white;
        border-radius: var(--radius);
        border: 2px dashed var(--border);
        padding: 4rem 2rem;
        text-align: center;
    }

        .empty-box .eb-icon {
            font-size: 3.5rem;
            display: block;
            margin-bottom: 1rem;
            opacity: 0.35;
        }

        .empty-box h4 {
            color: var(--green-dark);
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .empty-box p {
            color: var(--text-muted);
            font-size: 0.88rem;
            margin-bottom: 1.4rem;
        }
</style>

<div class="page-header">
    <div class="page-header-left">
        <h2>🏛️ প্রতিষ্ঠান তালিকা</h2>
        <p>গ্রামের সকল প্রতিষ্ঠান ও সংগঠন পরিচালনা করুন</p>
    </div>
    <a href="/Admin/InstitutionCreate" class="btn btn-primary">➕ নতুন প্রতিষ্ঠান</a>
</div>

@if (Model.Any())
{
    <div class="inst-stats">
        <div class="is-pill">🏛️ মোট: <strong>@Model.Count</strong></div>
        <div class="is-pill">✅ সক্রিয়: <strong>@activeCount</strong></div>
        <div class="is-pill">👥 মোট সদস্য: <strong>@Model.Sum(i => i.Members.Count)</strong></div>
    </div>

    <div class="card">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>আইকন</th>
                        <th>নাম</th>
                        <th>বিভাগ</th>
                        <th>প্রতিষ্ঠাকাল</th>
                        <th>সদস্য</th>
                        <th>স্ট্যাটাস</th>
                        <th>অ্যাকশন</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in Model)
                    {
                        <tr>
                            <td style="color:var(--text-muted);font-size:0.82rem;">@inst.SortOrder</td>
                            <td style="font-size:1.4rem;">@inst.Icon</td>
                            <td style="font-weight:700;color:var(--green-dark);">@inst.Name</td>
                            <td>
                                <span class="badge badge-blue">@inst.Category</span>
                            </td>
                            <td style="color:var(--text-muted);font-size:0.85rem;">@(string.IsNullOrEmpty(inst.FoundedYear) ? "—" : inst.FoundedYear)</td>
                            <td>
                                <span class="badge badge-success">@inst.Members.Count জন</span>
                            </td>
                            <td>
                                @if (inst.IsActive)
                                {
                                    <span class="badge badge-success">● সক্রিয়</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">○ নিষ্ক্রিয়</span>
                                }
                            </td>
                            <td>
                                <div class="actions-wrap">
                                    <a href="/Admin/InstitutionEdit/@inst.Id" class="btn btn-edit btn-sm">✏️ সম্পাদনা</a>
                                    <form method="post" action="/Admin/InstitutionDelete"
                                          style="display:inline;"
                                          onsubmit="return confirm('এই প্রতিষ্ঠান মুছে ফেলবেন?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@inst.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="empty-box">
        <span class="eb-icon">🏛️</span>
        <h4>কোনো প্রতিষ্ঠান নেই</h4>
        <p>গ্রামের মসজিদ, স্কুল, ক্লাব ও সংগঠনের তথ্য যোগ করুন।</p>
        <a href="/Admin/InstitutionCreate" class="btn btn-primary">➕ প্রথম প্রতিষ্ঠান যোগ করুন</a>
    </div>
}
