@model VillageInfoSystem.Models.Fund.Donation
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "অনুদান সম্পাদনা";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>✏️ অনুদান সম্পাদনা</h2>
    </div>
    <a href="/Admin/DonationList" class="btn btn-outline">← ফিরে যান</a>
</div>

<div class="card">
    <form method="post" enctype="multipart/form-data" action="/Admin/DonationEdit/@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="form-group">
            <label class="form-label">📌 শিরোনাম *</label>
            <input name="Title" class="form-control" value="@Model.Title" required />
        </div>
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">💰 পরিমাণ (টাকা) *</label>
                <input name="Amount" type="number" step="0.01" min="1"
                       class="form-control" value="@Model.Amount" required />
            </div>
            <div class="form-group">
                <label class="form-label">📅 তারিখ *</label>
                <input name="Date" type="date" class="form-control"
                       value="@Model.Date.ToString("yyyy-MM-dd")" required />
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">📝 বিবরণ</label>
            <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
        </div>
        <div class="form-group">
            <label class="form-label">🖼️ ছবি</label>
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" class="img-preview" />
            }
            <input name="image" type="file" class="form-control" accept="image/*" />
            <p class="form-hint">নতুন ছবি না দিলে পুরনোটা থাকবে</p>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">💾 আপডেট করুন</button>
    </form>
</div>