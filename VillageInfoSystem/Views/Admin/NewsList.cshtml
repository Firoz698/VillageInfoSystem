@model List<VillageInfoSystem.Models.News>
@{
    ViewData["Title"] = "সংবাদ ব্যবস্থাপনা";
    Layout = "_AdminLayout";
    int activeCount = Model.Count(n => n.IsActive);
    int featuredCount = Model.Count(n => n.IsFeatured);
    int withImageCount = Model.Count(n => !string.IsNullOrEmpty(n.ImagePath));
}

<style>
    :root {
        --radius: 12px;
        --shadow-sm: 0 2px 8px rgba(26,58,92,0.07);
        --shadow-md: 0 6px 24px rgba(26,58,92,0.12);
        --border: #dde3ec;
        --surface-alt: #f5f7fa;
    }

    /* ── Page Header ── */
    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.2rem;
    }

    .ph-left h2 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.05rem, 3.5vw, 1.4rem);
        color: var(--green-dark);
        font-weight: 900;
    }

    .ph-left p {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* ── Stats Pills ── */
    .news-stats {
        display: flex;
        gap: 0.55rem;
        margin-bottom: 1.1rem;
        flex-wrap: wrap;
    }

    .ns-pill {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.42rem 0.85rem;
        background: white;
        border: 1px solid var(--border);
        border-radius: 50px;
        font-size: 0.78rem;
        color: var(--text-muted);
        box-shadow: var(--shadow-sm);
        white-space: nowrap;
    }

        .ns-pill strong {
            color: var(--green-dark);
            font-size: 0.92rem;
            font-weight: 800;
        }

    /* ── Filter Bar ── */
    .filter-bar {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.1rem;
        flex-wrap: wrap;
        box-shadow: var(--shadow-sm);
    }

    .search-wrap {
        flex: 1;
        min-width: 160px;
        position: relative;
    }

        .search-wrap input {
            width: 100%;
            padding: 0.55rem 0.9rem 0.55rem 2.2rem;
            border: 1.5px solid var(--border);
            border-radius: 9px;
            font-family: 'Hind Siliguri', sans-serif;
            font-size: 0.85rem;
            transition: all 0.2s;
            background: white;
            color: var(--text);
        }

            .search-wrap input:focus {
                outline: none;
                border-color: var(--green);
                box-shadow: 0 0 0 3px rgba(26,107,60,0.08);
            }

    .search-icon {
        position: absolute;
        left: 0.7rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.82rem;
        pointer-events: none;
    }

    .filter-select {
        padding: 0.55rem 0.8rem;
        border: 1.5px solid var(--border);
        border-radius: 9px;
        font-family: 'Hind Siliguri', sans-serif;
        font-size: 0.82rem;
        color: var(--text);
        cursor: pointer;
        transition: all 0.2s;
        background: white;
        flex-shrink: 0;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--green);
        }

    /* ── Table Card ── */
    .table-card {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .tc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.2rem;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 0.6rem;
        background: var(--surface-alt);
    }

    .tc-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--green-dark);
        font-size: 0.92rem;
    }

    .tc-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: var(--green-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
    }

    /* ── Desktop Table ── */
    .table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.855rem;
    }

    thead th {
        background: #f5f8f5;
        color: var(--green-dark);
        padding: 0.65rem 0.9rem;
        text-align: left;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        border-bottom: 2px solid var(--border);
        white-space: nowrap;
    }

    tbody td {
        padding: 0.75rem 0.9rem;
        border-bottom: 1px solid #f2f6f2;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #f8fbf8;
    }

    tbody tr.filtered-out {
        display: none;
    }

    .news-thumb {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        object-fit: cover;
        display: block;
        border: 1px solid #e0ebe0;
    }

    .news-thumb-placeholder {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        background: #f0f5f0;
        border: 1px dashed #c8d8c8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        color: #adc4ad;
    }

    .news-icon-cell {
        font-size: 1.4rem;
        line-height: 1;
    }

    .news-title-cell {
        max-width: 220px;
    }

    .news-title-text {
        font-weight: 600;
        color: var(--text);
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .news-title-desc {
        font-size: 0.73rem;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin-top: 1px;
    }

    .actions-cell {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        white-space: nowrap;
    }

    .empty-row td {
        text-align: center;
        padding: 3.5rem 1rem;
        color: var(--text-muted);
    }

    .empty-row .er-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 0.7rem;
        opacity: 0.4;
    }

    /* ── Desktop visible / Mobile hidden ── */
    .desktop-table {
        display: block;
    }

    .mobile-list {
        display: none;
    }

    /* ── Mobile News Card ── */
    .m-news-card {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        transition: background 0.15s;
    }

        .m-news-card:last-child {
            border-bottom: none;
        }

        .m-news-card:hover {
            background: #f8fbf8;
        }

    .m-thumb {
        width: 52px;
        height: 52px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        border: 1px solid #e0ebe0;
    }

    .m-thumb-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 10px;
        background: #f0f5f0;
        border: 1px dashed #c8d8c8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .m-body {
        flex: 1;
        min-width: 0;
    }

    .m-title {
        font-weight: 700;
        color: var(--text);
        font-size: 0.88rem;
        line-height: 1.4;
        margin-bottom: 0.3rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .m-meta {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
        margin-bottom: 0.55rem;
    }

    .m-date {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    .m-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .m-badges {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
    }

    .m-actions {
        display: flex;
        gap: 0.35rem;
        align-items: center;
        flex-shrink: 0;
    }

    /* ── Responsive breakpoints ── */
    @@media (max-width: 860px) {
        .hide-tablet {
            display: none;
        }
    }

    @@media (max-width: 640px) {
        .desktop-table {
            display: none !important;
        }

        .mobile-list {
            display: block !important;
        }

        .page-header {
            margin-bottom: 0.9rem;
        }

        .filter-bar {
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.65rem 0.85rem;
        }

        .search-wrap {
            min-width: unset;
        }

        .filter-select {
            width: 100%;
        }

        .news-stats {
            gap: 0.4rem;
        }

        .ns-pill {
            font-size: 0.74rem;
            padding: 0.35rem 0.72rem;
        }
    }

    @@media (max-width: 400px) {
        .m-news-card {
            padding: 0.75rem 0.85rem;
            gap: 0.6rem;
        }

        .m-thumb, .m-thumb-placeholder {
            width: 46px;
            height: 46px;
        }

        .m-title {
            font-size: 0.84rem;
        }

        .m-footer {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<!-- Header -->
<div class="page-header">
    <div class="ph-left">
        <h2>📰 সংবাদ ব্যবস্থাপনা</h2>
        <p>গ্রামের সকল সংবাদ পরিচালনা করুন</p>
    </div>
    <a href="/Admin/NewsCreate" class="btn btn-primary">➕ নতুন সংবাদ</a>
</div>

<!-- Stats -->
@if (Model.Any())
{
    <div class="news-stats">
        <div class="ns-pill">📰 মোট: <strong>@Model.Count</strong></div>
        <div class="ns-pill">✅ সক্রিয়: <strong>@activeCount</strong></div>
        <div class="ns-pill">⭐ শীর্ষ: <strong>@featuredCount</strong></div>
        <div class="ns-pill">🖼️ ছবি সহ: <strong>@withImageCount</strong></div>
        @if (Model.Count - activeCount > 0)
        {
            <div class="ns-pill">⏸️ নিষ্ক্রিয়: <strong>@(Model.Count - activeCount)</strong></div>
        }
    </div>
}

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="searchInput" placeholder="সংবাদ খুঁজুন..." oninput="filterTable()" />
    </div>
    <select class="filter-select" id="catFilter" onchange="filterTable()">
        <option value="">সব বিভাগ</option>
        <option>সাধারণ</option>
        <option>শিক্ষা</option>
        <option>উন্নয়ন</option>
        <option>কৃষি</option>
        <option>স্বাস্থ্য</option>
        <option>ধর্মীয়</option>
        <option>খেলাধুলা</option>
        <option>সংস্কৃতি</option>
    </select>
    <select class="filter-select" id="statusFilter" onchange="filterTable()">
        <option value="">সব অবস্থা</option>
        <option value="active">সক্রিয়</option>
        <option value="inactive">নিষ্ক্রিয়</option>
        <option value="featured">শীর্ষ সংবাদ</option>
        <option value="hasimage">ছবি আছে</option>
        <option value="noimage">ছবি নেই</option>
    </select>
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="tc-header">
        <div class="tc-title">
            <div class="tc-icon">📋</div>
            সকল সংবাদ
            <span class="badge badge-gold" id="visibleCount">@Model.Count টি</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:3.5rem 1rem;color:var(--text-muted);">
            <div style="font-size:2.5rem;margin-bottom:0.7rem;opacity:0.4;">📭</div>
            এখনো কোনো সংবাদ যোগ করা হয়নি।
        </div>
    }
    else
    {
        <!-- ── Desktop Table ── -->
        <div class="table-wrap desktop-table">
            <table id="newsTable">
                <thead>
                    <tr>
                        <th style="width:52px">ছবি</th>
                        <th style="width:42px">আইকন</th>
                        <th>শিরোনাম</th>
                        <th class="hide-tablet">বিভাগ</th>
                        <th class="hide-tablet">তারিখ</th>
                        <th style="width:48px">শীর্ষ</th>
                        <th>অবস্থা</th>
                        <th style="width:155px">কার্যক্রম</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var n in Model)
                    {
                        <tr data-title="@n.Title.ToLower()"
                            data-cat="@n.Category"
                            data-active="@n.IsActive.ToString().ToLower()"
                            data-featured="@n.IsFeatured.ToString().ToLower()"
                            data-hasimage="@(!string.IsNullOrEmpty(n.ImagePath) ? "true" : "false")">

                            <td>
                                @if (!string.IsNullOrEmpty(n.ImagePath))
                                {
                                    <img src="@n.ImagePath" alt="@n.Title" class="news-thumb" loading="lazy" />
                                }
                                else
                                {
                                    <div class="news-thumb-placeholder">📷</div>
                                }
                            </td>

                            <td><div class="news-icon-cell">@n.Icon</div></td>

                            <td class="news-title-cell">
                                <span class="news-title-text" title="@n.Title">@n.Title</span>
                                @if (!string.IsNullOrEmpty(n.Description))
                                {
                                    <span class="news-title-desc">@(n.Description.Length > 55 ? n.Description.Substring(0, 55) + "…" : n.Description)</span>
                                }
                            </td>

                            <td class="hide-tablet">
                                <span class="badge badge-gold">@n.Category</span>
                            </td>

                            <td class="hide-tablet" style="color:var(--text-muted);font-size:0.78rem;white-space:nowrap;">
                                @n.PublishedAt.ToString("dd MMM yyyy")
                            </td>

                            <td style="text-align:center">
                                @if (n.IsFeatured)
                                {
                                    <text>⭐</text>
                                }
                                else
                                {

                                    <span style="color:#ccc">—</span>
                                }
                            </td>

                            <td>
                                <span class="badge @(n.IsActive ? "badge-success" : "badge-danger")">
                                    @(n.IsActive ? "✓ সক্রিয়" : "✗ নিষ্ক্রিয়")
                                </span>
                            </td>

                            <td>
                                <div class="actions-cell">
                                    <a href="/Admin/NewsEdit/@n.Id" class="btn btn-edit btn-sm">✏️ সম্পাদনা</a>
                                    <form method="post" action="/Admin/NewsDelete/@n.Id" style="display:inline"
                                          onsubmit="return confirm('এই সংবাদ মুছে ফেলবেন?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ── Mobile Cards ── -->
        <div class="mobile-list" id="mobileList">
            @foreach (var n in Model)
            {
                <div class="m-news-card"
                     data-title="@n.Title.ToLower()"
                     data-cat="@n.Category"
                     data-active="@n.IsActive.ToString().ToLower()"
                     data-featured="@n.IsFeatured.ToString().ToLower()"
                     data-hasimage="@(!string.IsNullOrEmpty(n.ImagePath) ? "true" : "false")">

                    @if (!string.IsNullOrEmpty(n.ImagePath))
                    {
                        <img src="@n.ImagePath" alt="@n.Title" class="m-thumb" loading="lazy" />
                    }
                    else
                    {
                        <div class="m-thumb-placeholder">@n.Icon</div>
                    }

                    <div class="m-body">
                        <div class="m-title">@n.Title</div>
                        <div class="m-meta">
                            <span class="badge badge-gold">@n.Category</span>
                            <span class="m-date">@n.PublishedAt.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="m-footer">
                            <div class="m-badges">
                                <span class="badge @(n.IsActive ? "badge-success" : "badge-danger")">
                                    @(n.IsActive ? "✓ সক্রিয়" : "✗ নিষ্ক্রিয়")
                                </span>
                                @if (n.IsFeatured)
                                {
                                    <span class="badge badge-gold">⭐ শীর্ষ</span>
                                }
                            </div>
                            <div class="m-actions">
                                <a href="/Admin/NewsEdit/@n.Id" class="btn btn-edit btn-sm">✏️ সম্পাদনা</a>
                                <form method="post" action="/Admin/NewsDelete/@n.Id" style="display:inline"
                                      onsubmit="return confirm('এই সংবাদ মুছে ফেলবেন?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const cat    = document.getElementById('catFilter').value;
        const status = document.getElementById('statusFilter').value;

        const isMobile = window.getComputedStyle(
            document.querySelector('.mobile-list')
        ).display !== 'none';

        // Desktop rows
        const rows  = document.querySelectorAll('#tableBody tr');
        // Mobile cards
        const cards = document.querySelectorAll('#mobileList .m-news-card');

        let visible = 0;

        function matches(el) {
            const titleMatch = !search || el.dataset.title.includes(search);
            const catMatch   = !cat    || el.dataset.cat === cat;
            let statusMatch  = true;
            if      (status === 'active')   statusMatch = el.dataset.active   === 'true';
            else if (status === 'inactive') statusMatch = el.dataset.active   === 'false';
            else if (status === 'featured') statusMatch = el.dataset.featured === 'true';
            else if (status === 'hasimage') statusMatch = el.dataset.hasimage === 'true';
            else if (status === 'noimage')  statusMatch = el.dataset.hasimage === 'false';
            return titleMatch && catMatch && statusMatch;
        }

        rows.forEach(r => {
            const show = matches(r);
            r.classList.toggle('filtered-out', !show);
        });

        cards.forEach(c => {
            const show = matches(c);
            c.style.display = show ? 'flex' : 'none';
            if (show && isMobile) visible++;
        });

        if (!isMobile) {
            visible = [...rows].filter(r => !r.classList.contains('filtered-out')).length;
        }

        const vc = document.getElementById('visibleCount');
        if (vc) vc.textContent = visible + ' টি';
    }
</script>
