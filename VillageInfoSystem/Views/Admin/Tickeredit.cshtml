@model VillageInfoSystem.Models.TickerNews
@{
    ViewData["Title"] = "ব্রেকিং নিউজ সম্পাদনা";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>✏️ ব্রেকিং নিউজ সম্পাদনা</h2>
        <p>টিকার নিউজের তথ্য আপডেট করুন</p>
    </div>
    <a href="/Admin/TickerList" class="btn btn-outline">← তালিকায় ফিরুন</a>
</div>

<div style="max-width: 700px;">
    <div class="card">
        <form method="post" action="/Admin/TickerEdit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label class="form-label">📝 টিকার টেক্সট <span style="color:#e74c3c;">*</span></label>
                <textarea name="Text"
                          class="form-control"
                          rows="3"
                          required
                          maxlength="300">@Model.Text</textarea>
                <div class="form-hint">সর্বোচ্চ ৩০০ অক্ষর।</div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">🔢 ক্রম নম্বর (SortOrder)</label>
                    <input type="number" name="SortOrder" class="form-control"
                           value="@Model.SortOrder" min="0" />
                </div>
                <div class="form-group" style="justify-content:flex-end; padding-top:1.8rem;">
                    <label class="form-check">
                        <input type="checkbox" name="IsActive" value="true"
                               @(Model.IsActive ? "checked" : "") />
                        <span class="form-check-label">সক্রিয় রাখুন</span>
                    </label>
                    <input type="hidden" name="IsActive" value="false" />
                </div>
            </div>

            <!-- Preview -->
            <div style="background:#082818; border-radius:10px; padding:0.7rem 1.2rem; margin-bottom:1.4rem; display:flex; align-items:center; gap:0.8rem; overflow:hidden;">
                <span style="background:#dc3545; color:white; font-size:0.72rem; font-weight:800; padding:0.2rem 0.6rem; border-radius:4px; white-space:nowrap; flex-shrink:0;">🔴 সর্বশেষ</span>
                <span style="color:rgba(255,255,255,0.82); font-size:0.84rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" id="tickerPreview">
                    @Model.Text
                </span>
            </div>

            <div style="display:flex; gap:0.8rem; flex-wrap:wrap;">
                <button type="submit" class="btn btn-primary btn-lg">💾 আপডেট করুন</button>
                <a href="/Admin/TickerList" class="btn btn-outline btn-lg">বাতিল</a>
            </div>
        </form>
    </div>
</div>

<script>
    const textarea = document.querySelector('textarea[name="Text"]');
    const preview  = document.getElementById('tickerPreview');
    textarea.addEventListener('input', () => {
        preview.textContent = textarea.value.trim() || '...';
    });
</script>
