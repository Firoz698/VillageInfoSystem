@* Views/Admin/FundEdit.cshtml *@
@model VillageInfoSystem.Models.FundCampaign
@{
    ViewData["Title"] = "ফান্ড সম্পাদনা";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>✏️ ফান্ড সম্পাদনা</h2>
        <p>@Model.Title — তথ্য আপডেট করুন</p>
    </div>
    <a href="/Admin/FundList" class="btn btn-outline">← ফিরে যান</a>
</div>

<div class="card" style="max-width:700px">
    <form method="post" action="/Admin/FundEdit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-group">
            <label class="form-label">ফান্ডের নাম <span style="color:#e74c3c">*</span></label>
            <input type="text" name="Title" class="form-control" value="@Model.Title" required />
        </div>

        <div class="form-group">
            <label class="form-label">বিবরণ</label>
            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">আইকন (emoji)</label>
                <input type="text" name="Icon" class="form-control" value="@Model.Icon" />
            </div>
            <div class="form-group">
                <label class="form-label">লক্ষ্যমাত্রা (টাকা)</label>
                <input type="number" name="GoalAmount" class="form-control" value="@Model.GoalAmount" min="0" />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">বর্তমান সংগৃহীত পরিমাণ (টাকা)</label>
            <input type="number" name="CollectedAmount" class="form-control" value="@Model.CollectedAmount" min="0" />
            <div class="form-hint">Accepted donation গুলো auto-update হয়, প্রয়োজনে manually এখানেও ঠিক করতে পারবেন।</div>
        </div>

        <div class="form-group">
            <label class="form-check">
                <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                <span class="form-check-label">সক্রিয়</span>
            </label>
        </div>

        <div class="d-flex gap-1 mt-2">
            <button type="submit" class="btn btn-primary btn-lg">💾 আপডেট করুন</button>
            <a href="/Admin/FundList" class="btn btn-outline">বাতিল</a>
        </div>
    </form>
</div>
