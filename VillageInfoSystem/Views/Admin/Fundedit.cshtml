@model VillageInfoSystem.Models.Fund.Fund
@{ 
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "ফান্ড সম্পাদনা";
    var users = ViewBag.Users as List<VillageInfoSystem.Models.Fund.User>;
}
<div class="page-header">
    <div class="page-header-left">
        <h2>✏️ ফান্ড এন্ট্রি সম্পাদনা</h2>
    </div>
    <a href="/Admin/FundList" class="btn btn-outline">← ফিরে যান</a>
</div>

<div class="card">
    <form method="post" enctype="multipart/form-data" action="/Admin/FundEdit/@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">👤 সদস্য *</label>
                <select name="UserId" class="form-control" required>
                    @if (users != null)
                    {
                        foreach (var u in users)
                        {
                            <option value="@u.Id" @@(u.Id == Model.UserId ? "selected" : "")>
                                @u.Name (@u.Phone)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">💰 পরিমাণ (টাকা) *</label>
                <input name="Amount" type="number" step="0.01" min="1"
                       class="form-control" value="@Model.Amount" required />
            </div>
        </div>
        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">📅 তারিখ</label>
                <input name="Date" type="date" class="form-control"
                       value="@Model.Date.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label class="form-label">🖼️ পেমেন্ট রসিদ</label>
                @if (!string.IsNullOrEmpty(Model.PaymentImage))
                {
                    <a href="@Model.PaymentImage" target="_blank">
                        <img src="@Model.PaymentImage" class="img-preview" />
                    </a>
                }
                <input name="paymentImage" type="file" class="form-control" accept="image/*" />
                <p class="form-hint">নতুন না দিলে পুরনোটা থাকবে</p>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">📝 পেমেন্ট নোট</label>
            <textarea name="PaymentNote" class="form-control" rows="3">@Model.PaymentNote</textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">💾 আপডেট করুন</button>
    </form>
</div>