@{
    ViewData["Title"] = "ড্যাশবোর্ড";
    Layout = "_AdminLayout";
    var recentNews = ViewBag.RecentNews as List<VillageInfoSystem.Models.News>;
    var recentFunds = ViewBag.RecentFunds as List<VillageInfoSystem.Models.Fund.Fund>;
    decimal totalFund = (decimal)(ViewBag.TotalFund ?? 0m);
    decimal totalDonation = (decimal)(ViewBag.TotalDonation ?? 0m);
    decimal netBalance = (decimal)(ViewBag.NetBalance ?? 0m);
}

<style>
    /* ═══════════════════════════════════════════════════════════
       DASHBOARD STYLES & ANIMATIONS
    ═══════════════════════════════════════════════════════════ */
    .dash-hero {
        position: relative;
        border-radius: var(--radius-xl);
        padding: 2.2rem 2.6rem;
        margin-bottom: 2rem;
        overflow: hidden;
        background: linear-gradient(135deg, #052012 0%, #0d5c2e 45%, #10b981 100%);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
        box-shadow: 0 16px 45px rgba(13, 92, 46, 0.28);
        border: 1px solid rgba(255, 255, 255, 0.15);
        animation: fadeUp 0.45s ease both;
    }

    .dash-hero::before {
        content: '';
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 68%);
        top: -160px;
        right: -80px;
        pointer-events: none;
    }

    .dash-hero::after {
        content: '';
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.22) 0%, transparent 70%);
        bottom: -100px;
        left: 25%;
        pointer-events: none;
    }

    .dh-dots {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
    }

    .dh-text {
        position: relative;
        z-index: 2;
    }

    .dh-greeting {
        font-family: 'Playfair Display', serif;
        font-size: 1.85rem;
        font-weight: 900;
        color: #ffffff;
        margin-bottom: 0.35rem;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
    }

    .dh-desc {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.85);
        max-width: 580px;
        line-height: 1.5;
    }

    .dh-badges {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .dh-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.55rem 1.15rem;
        border-radius: var(--radius-full);
        font-size: 0.82rem;
        font-weight: 700;
        backdrop-filter: blur(10px);
        white-space: nowrap;
    }

    .dh-pill-gold {
        background: rgba(245, 158, 11, 0.25);
        border: 1px solid rgba(245, 158, 11, 0.5);
        color: #fef08a;
    }

    .dh-pill-white {
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
    }

    /* ═══════════════════════════════════════════════════════════
       FINANCIAL STATS HERO (3 CARDS)
    ═══════════════════════════════════════════════════════════ */
    .fin-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.4rem;
        margin-bottom: 1.8rem;
    }

    .fin-card {
        border-radius: var(--radius-lg);
        padding: 1.6rem 1.8rem;
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: fadeUp 0.45s 0.08s ease both;
    }

    .fin-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
    }

    .fc-collected {
        background: linear-gradient(135deg, #092c19 0%, #0d5c2e 60%, #15803d 100%);
        color: #ffffff;
        border-color: rgba(0, 220, 130, 0.3);
    }

    .fc-balance {
        background: linear-gradient(135deg, #064e3b 0%, #047857 60%, #10b981 100%);
        color: #ffffff;
        border-color: rgba(52, 211, 153, 0.35);
    }

    .fc-spent {
        background: linear-gradient(135deg, #4c0519 0%, #881337 60%, #be123c 100%);
        color: #ffffff;
        border-color: rgba(244, 63, 94, 0.35);
    }

    .fin-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.8rem;
    }

    .fin-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        backdrop-filter: blur(8px);
    }

    .fin-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.25rem 0.7rem;
        border-radius: var(--radius-full);
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
    }

    .fin-amount {
        font-family: 'Playfair Display', serif;
        font-size: 2.1rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 0.35rem;
        letter-spacing: -0.01em;
    }

    .fin-label {
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 600;
    }

    /* ═══════════════════════════════════════════════════════════
       SECONDARY METRIC CARDS (4-GRID)
    ═══════════════════════════════════════════════════════════ */
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .metric-card {
        background: #ffffff;
        border-radius: var(--radius-md);
        padding: 1.3rem 1.4rem;
        border: 1.5px solid var(--border-color);
        box-shadow: var(--shadow-card);
        display: flex;
        align-items: center;
        gap: 1.1rem;
        transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
    }

    .metric-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-hover);
        border-color: rgba(13, 92, 46, 0.25);
    }

    .metric-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3.5px;
    }

    .mc-users::before { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    .mc-news::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .mc-inst::before { background: linear-gradient(90deg, #8b5cf6, #c084fc); }
    .mc-facility::before { background: linear-gradient(90deg, #10b981, #34d399); }

    .mc-icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
        transition: transform 0.3s;
    }

    .metric-card:hover .mc-icon-wrap {
        transform: scale(1.15) rotate(-5deg);
    }

    .mc-users .mc-icon-wrap { background: #e0f2fe; color: #0284c7; }
    .mc-news .mc-icon-wrap { background: #fef3c7; color: #d97706; }
    .mc-inst .mc-icon-wrap { background: #ede9fe; color: #7c3aed; }
    .mc-facility .mc-icon-wrap { background: #d1fae5; color: #059669; }

    .mc-content {
        min-width: 0;
    }

    .mc-num {
        font-family: 'Playfair Display', serif;
        font-size: 1.85rem;
        font-weight: 900;
        line-height: 1;
        color: var(--text-main);
    }

    .mc-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 4px;
        font-weight: 600;
    }

    /* ═══════════════════════════════════════════════════════════
       MAIN 2-COLUMN LAYOUT
    ═══════════════════════════════════════════════════════════ */
    .dash-columns {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 1.6rem;
        align-items: start;
    }

    /* Recent Table Cards */
    .dash-table-card {
        background: #ffffff;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border-color);
        overflow: hidden;
        margin-bottom: 1.6rem;
        transition: box-shadow 0.25s;
    }

    .dash-table-card:hover {
        box-shadow: var(--shadow-hover);
    }

    .dtc-header {
        padding: 1.2rem 1.6rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fafcfa;
        flex-wrap: wrap;
        gap: 0.8rem;
    }

    .dtc-title {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--brand-green-dark);
    }

    .dtc-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: rgba(13, 92, 46, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    /* ═══════════════════════════════════════════════════════════
       QUICK ACTION LAUNCHPAD
    ═══════════════════════════════════════════════════════════ */
    .launchpad-card {
        background: #ffffff;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border-color);
        overflow: hidden;
        position: sticky;
        top: 90px;
    }

    .lp-header {
        padding: 1.2rem 1.5rem;
        background: linear-gradient(135deg, #0d5c2e 0%, #16a34a 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .lp-body {
        padding: 1.3rem;
    }

    .lp-section-title {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        margin: 1.1rem 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .lp-section-title:first-child {
        margin-top: 0;
    }

    .lp-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-sm);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
        margin-bottom: 0.45rem;
        transition: all 0.22s ease;
        border: 1px solid transparent;
    }

    .lp-btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        flex-shrink: 0;
        transition: transform 0.2s;
    }

    .lp-btn:hover {
        transform: translateX(4px);
    }

    .lp-btn:hover .lp-btn-icon {
        transform: scale(1.15);
    }

    .lp-green {
        background: #f0fdf4;
        color: #166534;
        border-color: #bbf7d0;
    }
    .lp-green .lp-btn-icon { background: #dcfce7; }
    .lp-green:hover { background: #dcfce7; }

    .lp-gold {
        background: #fefce8;
        color: #854d0e;
        border-color: #fef08a;
    }
    .lp-gold .lp-btn-icon { background: #fef9c3; }
    .lp-gold:hover { background: #fef9c3; }

    .lp-blue {
        background: #f0f9ff;
        color: #075985;
        border-color: #bae6fd;
    }
    .lp-blue .lp-btn-icon { background: #e0f2fe; }
    .lp-blue:hover { background: #e0f2fe; }

    .lp-purple {
        background: #faf5ff;
        color: #6b21a8;
        border-color: #e9d5ff;
    }
    .lp-purple .lp-btn-icon { background: #f3e8ff; }
    .lp-purple:hover { background: #f3e8ff; }

    .lp-rose {
        background: #fff1f2;
        color: #9f1239;
        border-color: #fecdd3;
    }
    .lp-rose .lp-btn-icon { background: #ffe4e6; }
    .lp-rose:hover { background: #ffe4e6; }

    /* ═══════════════════════════════════════════════════════════
       ANIMATIONS
    ═══════════════════════════════════════════════════════════ */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ═══════════════════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════════════════ */
    @@media (max-width: 1180px) {
        .metric-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .dash-columns {
            grid-template-columns: 1fr;
        }
        .launchpad-card {
            position: static;
        }
    }

    @@media (max-width: 860px) {
        .fin-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    @@media (max-width: 600px) {
        .dash-hero {
            padding: 1.6rem 1.4rem;
        }
        .dh-greeting {
            font-size: 1.4rem;
        }
        .metric-grid {
            grid-template-columns: 1fr 1fr;
            gap: 0.85rem;
        }
        .mc-num {
            font-size: 1.5rem;
        }
        .fin-amount {
            font-size: 1.7rem;
        }
    }
</style>

<!-- ── WELCOME HERO BANNER ── -->
<div class="dash-hero">
    <div class="dh-dots"></div>
    <div class="dh-text">
        <h1 class="dh-greeting">আস-সালামু আলাইকুম, @(User.Identity?.Name ?? "অ্যাডমিন")! 👋</h1>
        <p class="dh-desc">খোকসা মল্লিক পাড়া গ্রাম তথ্য, নাগরিক সেবা ও তহবিল ব্যবস্থাপনা কন্ট্রোল সেন্টারে আপনাকে স্বাগতম।</p>
    </div>
    <div class="dh-badges">
        <div class="dh-pill dh-pill-gold">🌿 খোকসা মল্লিক পাড়া</div>
        <div class="dh-pill dh-pill-white">📅 @DateTime.Now.ToString("dd MMMM, yyyy")</div>
    </div>
</div>

<!-- ── 3 FINANCIAL HERO CARDS ── -->
<div class="fin-grid">
    <!-- Collected -->
    <div class="fin-card fc-collected">
        <div class="fin-top">
            <div class="fin-icon-wrap">💰</div>
            <span class="fin-badge">সর্বমোট সংগৃহীত</span>
        </div>
        <div class="fin-amount">৳ @totalFund.ToString("N0")</div>
        <div class="fin-label">গ্রামের উন্নয়ন তহবিলের মোট সংগ্রহ</div>
    </div>

    <!-- Balance -->
    <div class="fin-card fc-balance">
        <div class="fin-top">
            <div class="fin-icon-wrap">⚖️</div>
            <span class="fin-badge">বর্তমান ব্যালেন্স</span>
        </div>
        <div class="fin-amount">৳ @netBalance.ToString("N0")</div>
        <div class="fin-label">খরচ বাদে অবশিষ্ট নিট ব্যালেন্স</div>
    </div>

    <!-- Spent -->
    <div class="fin-card fc-spent">
        <div class="fin-top">
            <div class="fin-icon-wrap">🏗️</div>
            <span class="fin-badge">মোট খরচ / অনুদান</span>
        </div>
        <div class="fin-amount">৳ @totalDonation.ToString("N0")</div>
        <div class="fin-label">গ্রামের বিভিন্ন প্রকল্পে মোট ব্যয়</div>
    </div>
</div>

<!-- ── 4 SECONDARY METRIC CARDS ── -->
<div class="metric-grid">
    <div class="metric-card mc-users">
        <div class="mc-icon-wrap">👥</div>
        <div class="mc-content">
            <div class="mc-num">@(ViewBag.UserCount ?? 0)</div>
            <div class="mc-label">নিবন্ধিত সদস্য</div>
        </div>
    </div>
    <div class="metric-card mc-news">
        <div class="mc-icon-wrap">📰</div>
        <div class="mc-content">
            <div class="mc-num">@(ViewBag.NewsCount ?? 0)</div>
            <div class="mc-label">প্রকাশিত সংবাদ</div>
        </div>
    </div>
    <div class="metric-card mc-inst">
        <div class="mc-icon-wrap">🏢</div>
        <div class="mc-content">
            <div class="mc-num">@(ViewBag.InstitutionCount ?? 0)</div>
            <div class="mc-label">গ্রামের প্রতিষ্ঠান</div>
        </div>
    </div>
    <div class="metric-card mc-facility">
        <div class="mc-icon-wrap">🏛️</div>
        <div class="mc-content">
            <div class="mc-num">@(ViewBag.FacilityCount ?? 0)</div>
            <div class="mc-label">নাগরিক সুবিধাসমূহ</div>
        </div>
    </div>
</div>

<!-- ── 2-COLUMN MAIN DASHBOARD CONTENT ── -->
<div class="dash-columns">

    <!-- LEFT COLUMN: RECENT TABLES -->
    <div>
        <!-- Recent News Table -->
        <div class="dash-table-card">
            <div class="dtc-header">
                <div class="dtc-title">
                    <div class="dtc-icon">📰</div>
                    সাম্প্রতিক সংবাদ ও নোটিশ
                </div>
                <a href="/News/NewsList" class="btn btn-sm btn-outline">সব সংবাদ দেখুন →</a>
            </div>
            <div class="table-wrap">
                @if (recentNews != null && recentNews.Any())
                {
                    <table>
                        <thead>
                            <tr>
                                <th>সংবাদের শিরোনাম</th>
                                <th>বিভাগ</th>
                                <th>তারিখ</th>
                                <th>অবস্থা</th>
                                <th style="text-align:right;">অ্যাকশন</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in recentNews)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:700;color:var(--brand-green-dark);display:flex;align-items:center;gap:0.45rem;">
                                            <span>@n.Icon</span>
                                            <span>@n.Title</span>
                                        </div>
                                    </td>
                                    <td><span class="badge badge-gold">@n.Category</span></td>
                                    <td class="text-muted" style="font-size:0.8rem;">@n.PublishedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @(n.IsActive ? "badge-success" : "badge-danger")">
                                            @(n.IsActive ? "✓ সক্রিয়" : "✗ নিষ্ক্রিয়")
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <a href="/News/NewsEdit/@n.Id" class="btn btn-sm btn-edit">✏️ সম্পাদনা</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center;padding:2.5rem;color:var(--text-muted);">
                        <div style="font-size:2rem;margin-bottom:0.5rem;">📭</div>
                        <p>এখনো কোনো সংবাদ এন্ট্রি নেই।</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Fund Collections -->
        <div class="dash-table-card">
            <div class="dtc-header">
                <div class="dtc-title">
                    <div class="dtc-icon">💵</div>
                    সাম্প্রতিক চাঁদা এন্ট্রি
                </div>
                <div class="d-flex gap-1">
                    <a href="/Fund/FundReport" class="btn btn-sm btn-outline">📄 PDF রিপোর্ট</a>
                    <a href="/Fund/FundList" class="btn btn-sm btn-primary">সকল ফান্ড →</a>
                </div>
            </div>
            <div class="table-wrap">
                @if (recentFunds != null && recentFunds.Any())
                {
                    <table>
                        <thead>
                            <tr>
                                <th>সদস্যের নাম</th>
                                <th>পরিমাণ</th>
                                <th>তারিখ</th>
                                <th>রসিদ</th>
                                <th style="text-align:right;">অ্যাকশন</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in recentFunds)
                            {
                                <tr>
                                    <td style="font-weight:700;color:var(--brand-green-dark);">
                                        @(f.User?.Name ?? "—")
                                    </td>
                                    <td>
                                        <span class="badge badge-success" style="font-size:0.84rem;">
                                            ৳ @f.Amount.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="text-muted" style="font-size:0.8rem;">
                                        @f.Date.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(f.PaymentImage))
                                        {
                                            <a href="@f.PaymentImage" target="_blank" style="text-decoration:none;">
                                                <span class="badge badge-blue">🖼️ রসিদ</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size:0.75rem;">—</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <a href="/Fund/FundEdit/@f.Id" class="btn btn-sm btn-edit">✏️</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center;padding:2.5rem;color:var(--text-muted);">
                        <div style="font-size:2rem;margin-bottom:0.5rem;">💸</div>
                        <p>এখনো কোনো ফান্ড কালেকশন এন্ট্রি নেই।</p>
                    </div>
                }
            </div>
        </div>
    </div>

