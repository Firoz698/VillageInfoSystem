@* ══════════════════════════════════════
   Views/Admin/FundCreate.cshtml
   ══════════════════════════════════════ *@
@model VillageInfoSystem.Models.FundCampaign
@{
    ViewData["Title"] = "নতুন ফান্ড";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>➕ নতুন ফান্ড তৈরি করুন</h2>
        <p>গ্রামের উন্নয়নের জন্য নতুন ফান্ড ক্যাম্পেইন তৈরি করুন</p>
    </div>
    <a href="/Admin/FundList" class="btn btn-outline">← ফিরে যান</a>
</div>

<div class="card" style="max-width:700px">
    <form method="post" action="/Admin/FundCreate">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div class="form-group" style="grid-column:1/-1">
                <label class="form-label">ফান্ডের নাম <span style="color:#e74c3c">*</span></label>
                <input type="text" name="Title" class="form-control" placeholder="যেমন: মসজিদ সংস্কার ফান্ড" required />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">বিবরণ</label>
            <textarea name="Description" class="form-control" rows="3"
                      placeholder="ফান্ডের উদ্দেশ্য ও বিস্তারিত বিবরণ..."></textarea>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">আইকন (emoji)</label>
                <input type="text" name="Icon" class="form-control" value="💰" placeholder="💰" />
            </div>
            <div class="form-group">
                <label class="form-label">লক্ষ্যমাত্রা (টাকা) <span style="color:#e74c3c">*</span></label>
                <input type="number" name="GoalAmount" class="form-control" placeholder="500000" min="1000" required />
            </div>
        </div>

        <div class="form-group">
            <label class="form-check">
                <input type="checkbox" name="IsActive" value="true" checked />
                <span class="form-check-label">সক্রিয় (ওয়েবসাইটে দেখাবে)</span>
            </label>
        </div>

        <div class="d-flex gap-1 mt-2">
            <button type="submit" class="btn btn-primary btn-lg">💾 সংরক্ষণ করুন</button>
            <a href="/Admin/FundList" class="btn btn-outline">বাতিল</a>
        </div>
    </form>
</div>


