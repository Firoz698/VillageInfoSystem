@model VillageInfoSystem.Models.TickerNews
@{
    ViewData["Title"] = "নতুন টিকার যোগ করুন";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>📺 নতুন ব্রেকিং নিউজ যোগ করুন</h2>
        <p>ওয়েবসাইটের উপরে স্ক্রল করে দেখানো সংবাদ যোগ করুন</p>
    </div>
    <a href="/Ticker/TickerList" class="btn btn-outline">← তালিকায় ফিরুন</a>
</div>

<div style="max-width: 700px;">
    <div class="card">
        <form method="post" action="/Ticker/TickerCreate">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">📝 টিকার টেক্সট <span style="color:#e74c3c;">*</span></label>
                <textarea name="Text"
                          class="form-control"
                          rows="3"
                          required
                          maxlength="300"
                          placeholder="যেমন: খোকসা মল্লিক পাড়া গ্রামে নতুন প্রাথমিক বিদ্যালয় ভবন নির্মাণ কাজ শুরু হয়েছে...">@Model.Text</textarea>
                <div class="form-hint">সর্বোচ্চ ৩০০ অক্ষর। স্ক্রলিং টিকারে এই টেক্সট দেখাবে।</div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">🔢 ক্রম নম্বর (SortOrder)</label>
                    <input type="number"
                           name="SortOrder"
                           class="form-control"
                           value="@Model.SortOrder"
                           min="0"
                           placeholder="0" />
                    <div class="form-hint">ছোট সংখ্যা আগে দেখাবে</div>
                </div>
                <div class="form-group" style="justify-content:flex-end;padding-top:1.8rem;">
                    <label class="form-check">
                        <input type="checkbox" name="IsActive" value="true" checked />
                        <span class="form-check-label">সক্রিয় রাখুন</span>
                    </label>
                    <input type="hidden" name="IsActive" value="false" />
                    <div class="form-hint" style="margin-top:0.4rem;">বন্ধ থাকলে টিকারে দেখাবে না</div>
                </div>
            </div>

            <!-- Preview -->
            <div style="background: #082818; border-radius: 10px; padding: 0.7rem 1.2rem; margin-bottom: 1.4rem; display:flex; align-items:center; gap:0.8rem; overflow:hidden;">
                <span style="background:#dc3545; color:white; font-size:0.72rem; font-weight:800; padding:0.2rem 0.6rem; border-radius:4px; white-space:nowrap; flex-shrink:0;">🔴 সর্বশেষ</span>
                <span style="color:rgba(255,255,255,0.82); font-size:0.84rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" id="tickerPreview">
                    টেক্সট লিখলে এখানে প্রিভিউ দেখাবে...
                </span>
            </div>

            <div style="display:flex; gap:0.8rem; flex-wrap:wrap;">
                <button type="submit" class="btn btn-primary btn-lg">💾 সংরক্ষণ করুন</button>
                <a href="/Ticker/TickerList" class="btn btn-outline btn-lg">বাতিল</a>
            </div>
        </form>
    </div>

    <!-- Tips -->
    <div class="card" style="background: linear-gradient(135deg, rgba(26,107,60,0.04), rgba(26,107,60,0.08)); border-color: rgba(26,107,60,0.12);">
        <div style="font-weight:700; color:var(--green-dark); margin-bottom:0.8rem; font-size:0.9rem;">💡 টিপস</div>
        <div style="display:flex; flex-direction:column; gap:0.55rem;">
            <div style="font-size:0.82rem; color:var(--text-muted); display:flex; gap:0.5rem;">
                <span style="color:var(--green);">●</span>
                টিকার টেক্সট সংক্ষিপ্ত ও স্পষ্ট রাখুন
            </div>
            <div style="font-size:0.82rem; color:var(--text-muted); display:flex; gap:0.5rem;">
                <span style="color:var(--green);">●</span>
                সাম্প্রতিক ও গুরুত্বপূর্ণ খবর টিকারে দিন
            </div>
            <div style="font-size:0.82rem; color:var(--text-muted); display:flex; gap:0.5rem;">
                <span style="color:var(--green);">●</span>
                একাধিক টিকার থাকলে ক্রম নম্বর দিয়ে সাজান
            </div>
        </div>
    </div>
</div>

<script>
    // Live preview
    const textarea = document.querySelector('textarea[name="Text"]');
    const preview  = document.getElementById('tickerPreview');

    function updatePreview() {
        const val = textarea.value.trim();
        preview.textContent = val || 'টেক্সট লিখলে এখানে প্রিভিউ দেখাবে...';
        preview.style.color = val ? 'rgba(255,255,255,0.88)' : 'rgba(255,255,255,0.38)';
    }

    textarea.addEventListener('input', updatePreview);
    updatePreview();
</script>
