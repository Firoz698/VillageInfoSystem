@model List<VillageInfoSystem.Models.TickerNews>
@{
    ViewData["Title"] = "ব্রেকিং নিউজ";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --primary: #1a3a5c;
        --primary-light: #2563a8;
        --red: #c0392b;
        --success: #1a7a4a;
        --danger: #b53a2e;
        --surface: #ffffff;
        --surface-alt: #f5f7fa;
        --border: #dde3ec;
        --text-main: #1a2636;
        --text-muted: #5a6b80;
        --shadow-sm: 0 2px 8px rgba(26,58,92,0.07);
        --shadow-md: 0 6px 24px rgba(26,58,92,0.12);
        --radius: 12px;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .page-wrapper {
        animation: fadeUp 0.4s ease both;
        width: 100%;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Ticker Preview ── */
    .ticker-preview {
        background: linear-gradient(90deg, var(--red) 0%, #a52820 100%);
        border-radius: var(--radius);
        margin-bottom: 1.25rem;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(192,57,43,0.22);
        display: flex;
        align-items: stretch;
        min-height: 42px;
        width: 100%;
    }

    .ticker-label {
        background: rgba(0,0,0,0.28);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.38rem;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .ticker-label .dot {
            width: 6px;
            height: 6px;
            background: #ff6b6b;
            border-radius: 50%;
            animation: pulse 1.2s ease-in-out infinite;
            flex-shrink: 0;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(0.72);
        }
    }

    .ticker-scroll-wrapper {
        flex: 1;
        overflow: hidden;
        display: flex;
        align-items: center;
        position: relative;
        min-width: 0;
    }

        .ticker-scroll-wrapper::before,
        .ticker-scroll-wrapper::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 24px;
            z-index: 1;
            pointer-events: none;
        }

        .ticker-scroll-wrapper::before {
            left: 0;
            background: linear-gradient(to right, rgba(160,40,32,0.55), transparent);
        }

        .ticker-scroll-wrapper::after {
            right: 0;
            background: linear-gradient(to left, rgba(160,40,32,0.55), transparent);
        }

    .ticker-scroll {
        display: flex;
        align-items: center;
        gap: 2rem;
        white-space: nowrap;
        animation: scrollTicker 22s linear infinite;
        padding: 0 0.75rem;
        color: #fff;
        font-size: 0.82rem;
        font-weight: 500;
    }

        .ticker-scroll:hover {
            animation-play-state: paused;
        }

    @@keyframes scrollTicker {
        0% {
            transform: translateX(100%);
        }

        100% {
            transform: translateX(-100%);
        }
    }

    .ticker-sep {
        opacity: 0.38;
    }

    /* ── Page Header ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: nowrap;
    }

    .page-header-left {
        min-width: 0;
        flex: 1;
    }

        .page-header-left h1 {
            font-family: 'Noto Serif Bengali', Georgia, serif;
            font-size: clamp(1rem, 3.5vw, 1.4rem);
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.1rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .page-header-left p {
            font-size: clamp(0.72rem, 2vw, 0.8rem);
            color: var(--text-muted);
        }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--primary);
        color: #fff;
        text-decoration: none;
        padding: 0.52rem 0.9rem;
        border-radius: 8px;
        font-size: 0.84rem;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(26,58,92,0.18);
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .btn-add:hover {
            background: var(--primary-light);
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(26,58,92,0.22);
        }

    /* ── Stats ── */
    .stats-bar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.65rem;
        margin-bottom: 1rem;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.85rem 0.9rem;
        box-shadow: var(--shadow-sm);
        transition: box-shadow 0.2s;
    }

        .stat-card:hover {
            box-shadow: var(--shadow-md);
        }

    .stat-label {
        font-size: clamp(0.6rem, 1.8vw, 0.68rem);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin-bottom: 0.22rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .stat-value {
        font-size: clamp(1.2rem, 4vw, 1.55rem);
        font-weight: 700;
        color: var(--primary);
        line-height: 1;
    }

    .stat-card.success .stat-value {
        color: var(--success);
    }

    .stat-card.danger .stat-value {
        color: var(--danger);
    }

    /* ── Table Card ── */
    .table-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        width: 100%;
    }

    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        padding: 0.8rem 0.9rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface-alt);
        flex-wrap: nowrap;
    }

    .search-box {
        position: relative;
        display: flex;
        align-items: center;
        flex: 1;
        min-width: 0;
        max-width: 260px;
    }

        .search-box svg {
            position: absolute;
            left: 0.65rem;
            color: var(--text-muted);
            pointer-events: none;
            flex-shrink: 0;
        }

        .search-box input {
            width: 100%;
            padding: 0.4rem 0.8rem 0.4rem 2rem;
            border: 1px solid var(--border);
            border-radius: 7px;
            font-size: 0.82rem;
            background: var(--surface);
            outline: none;
            color: var(--text-main);
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .search-box input:focus {
                border-color: var(--primary-light);
                box-shadow: 0 0 0 3px rgba(37,99,168,0.12);
            }

    .table-count {
        font-size: 0.78rem;
        color: var(--text-muted);
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* ── Desktop Table ── */
    .table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }

    table.data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.84rem;
        color: var(--text-main);
    }

        table.data-table thead th {
            background: var(--surface-alt);
            padding: 0.65rem 0.85rem;
            font-size: 0.67rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            text-align: left;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

            table.data-table thead th.center {
                text-align: center;
            }

        table.data-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }

            table.data-table tbody tr:last-child {
                border-bottom: none;
            }

            table.data-table tbody tr:hover {
                background: #f0f5fb;
            }

        table.data-table td {
            padding: 0.75rem 0.85rem;
            vertical-align: middle;
        }

            table.data-table td.center {
                text-align: center;
            }

    .order-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: #eff4ff;
        border: 1px solid #c5d7f8;
        color: #2b5aad;
        font-size: 0.77rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .news-text-cell {
        max-width: 320px;
    }

    .news-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
        color: var(--text-main);
        word-break: break-word;
    }

    /* ── Toggle Switch ── */
    .toggle-wrap {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
    }

    .toggle-switch {
        position: relative;
        width: 38px;
        height: 21px;
        display: inline-block;
        flex-shrink: 0;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #d1d5db;
        border-radius: 999px;
        transition: background 0.25s;
    }

        .toggle-slider::before {
            content: '';
            position: absolute;
            width: 15px;
            height: 15px;
            left: 3px;
            top: 3px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.25s;
            box-shadow: 0 1px 4px rgba(0,0,0,0.2);
        }

    .toggle-switch input:checked + .toggle-slider {
        background: #1a7a4a;
    }

        .toggle-switch input:checked + .toggle-slider::before {
            transform: translateX(17px);
        }

    .toggle-switch.loading .toggle-slider {
        opacity: 0.55;
        cursor: wait;
    }

    .toggle-label {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.03em;
    }

        .toggle-label.active {
            color: #1a7a4a;
        }

        .toggle-label.inactive {
            color: #b53a2e;
        }

    /* ── Buttons ── */
    .action-group {
        display: inline-flex;
        gap: 0.3rem;
        align-items: center;
        justify-content: center;
    }

    .btn-edit, .btn-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.28rem;
        border-radius: 7px;
        font-size: 0.74rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, transform 0.12s;
        white-space: nowrap;
        padding: 0.32rem 0.65rem;
        text-decoration: none;
        border-width: 1px;
        border-style: solid;
    }

    .btn-edit {
        background: #eff4ff;
        border-color: #c5d7f8;
        color: #2b5aad;
    }

    .btn-delete {
        background: #fff1f0;
        border-color: #f8bcb7;
        color: #b53a2e;
    }

    .btn-edit:hover {
        background: #dbeaff;
        border-color: #93baf7;
        color: #1a4a9a;
        transform: translateY(-1px);
    }

    .btn-delete:hover {
        background: #ffe3e0;
        border-color: #f5a09a;
        transform: translateY(-1px);
    }

    /* ── Toast ── */
    .toast-container {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        pointer-events: none;
        max-width: calc(100vw - 2rem);
    }

    .toast {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.6rem 0.9rem;
        border-radius: 9px;
        font-size: 0.81rem;
        font-weight: 600;
        box-shadow: 0 4px 18px rgba(0,0,0,0.14);
        pointer-events: auto;
        animation: toastIn 0.3s ease both;
    }

        .toast.success {
            background: #ecfdf3;
            color: #1a7a4a;
            border: 1px solid #a7e6c3;
        }

        .toast.error {
            background: #fff1f0;
            color: #b53a2e;
            border: 1px solid #f8bcb7;
        }

        .toast.hide {
            animation: toastOut 0.3s ease both;
        }

    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes toastOut {
        from {
            opacity: 1;
            transform: translateY(0);
        }

        to {
            opacity: 0;
            transform: translateY(8px);
        }
    }

    /* ── Mobile / Desktop visibility ──
               CSS দিয়ে control — JS window.innerWidth নয় ── */
    .desktop-table {
        display: block;
    }

    .mobile-list {
        display: none;
    }

    .news-card {
        padding: 0.85rem 0.9rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        gap: 0.65rem;
        align-items: flex-start;
        transition: background 0.15s;
    }

        .news-card:last-child {
            border-bottom: none;
        }

        .news-card:hover {
            background: #f4f7fc;
        }

    .news-card-body {
        flex: 1;
        min-width: 0;
    }

    .news-card-title {
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--text-main);
        margin-bottom: 0.55rem;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }

    .news-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .toggle-inline {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
    }

    .card-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    /* ── Empty State ── */
    .empty-state {
        text-align: center;
        padding: 3rem 1.5rem;
        color: var(--text-muted);
    }

        .empty-state .empty-icon {
            font-size: 2.4rem;
            display: block;
            margin-bottom: 0.65rem;
            opacity: 0.5;
        }

        .empty-state p {
            margin-bottom: 1.2rem;
            font-size: 0.87rem;
        }

    /* ══════════ TABLET ══════════ */
    @@media (max-width: 860px) {
        .btn-txt {
            display: none;
        }

        .btn-edit, .btn-delete {
            padding: 0.35rem 0.45rem;
        }

        .news-text-cell {
            max-width: 220px;
        }
    }

    /* ══════════ MOBILE — card view ══════════ */
    @@media screen and (max-width: 640px) {
        .desktop-table {
            display: none !important;
        }

        .mobile-list {
            display: block !important;
        }

        .page-header {
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.85rem;
        }

        .page-header-left h1 {
            font-size: 1.05rem;
        }

        .page-header-left p {
            font-size: 0.72rem;
        }

        .btn-add-text {
            display: none;
        }

        .btn-add {
            padding: 0.48rem 0.75rem;
        }

        .ticker-preview {
            min-height: 38px;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .ticker-label {
            font-size: 0.58rem;
            padding: 0 0.6rem;
        }

        .ticker-scroll {
            font-size: 0.74rem;
            gap: 1.4rem;
        }

        .stats-bar {
            gap: 0.45rem;
            margin-bottom: 0.9rem;
        }

        .stat-card {
            padding: 0.65rem 0.7rem;
            border-radius: 10px;
        }

        .stat-label {
            font-size: 0.6rem;
        }

        .stat-value {
            font-size: 1.2rem;
        }

        .table-toolbar {
            padding: 0.65rem 0.8rem;
            gap: 0.45rem;
        }

        .search-box {
            flex: 1;
            max-width: none;
        }

            .search-box input {
                width: 100%;
                font-size: 0.8rem;
            }

        .table-count {
            font-size: 0.75rem;
        }

        .news-card {
            padding: 0.8rem 0.85rem;
            gap: 0.6rem;
        }

        .news-card-title {
            font-size: 0.84rem;
        }

        .order-chip {
            width: 24px;
            height: 24px;
            font-size: 0.72rem;
            border-radius: 5px;
        }

        .toggle-inline {
            gap: 0.38rem;
        }

        .toggle-switch {
            width: 36px;
            height: 20px;
        }

        .toggle-slider::before {
            width: 14px;
            height: 14px;
        }

        .toggle-switch input:checked + .toggle-slider::before {
            transform: translateX(16px);
        }

        .toggle-label {
            font-size: 0.64rem;
        }

        .card-actions {
            gap: 0.28rem;
        }

        .btn-edit, .btn-delete {
            padding: 0.3rem 0.55rem;
            font-size: 0.73rem;
        }
    }

    /* ══════════ SMALL PHONE ══════════ */
    @@media screen and (max-width: 400px) {
        .stats-bar {
            grid-template-columns: 1fr 1fr;
        }

            .stats-bar .stat-card:last-child {
                grid-column: 1 / -1;
            }

        .news-card {
            padding: 0.72rem 0.75rem;
        }

        .news-card-title {
            font-size: 0.8rem;
        }

        .news-card-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.4rem;
        }

        .card-actions {
            margin-left: 0;
        }

        .btn-edit, .btn-delete {
            padding: 0.28rem 0.48rem;
            font-size: 0.7rem;
        }
    }
</style>

<div class="toast-container" id="toastContainer"></div>

<div class="page-wrapper">

    <!-- Live Ticker Preview -->
    <div id="tickerPreviewWrapper">
        @if (Model.Any(t => t.IsActive))
        {
            <div class="ticker-preview">
                <div class="ticker-label">
                    <span class="dot"></span> লাইভ
                </div>
                <div class="ticker-scroll-wrapper">
                    <div class="ticker-scroll">
                        @foreach (var t in Model.Where(t => t.IsActive).OrderBy(t => t.SortOrder))
                        {
                            <span>@t.Text</span>
                            <span class="ticker-sep">◆</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Header -->
    <div class="page-header">
        <div class="page-header-left">
            <h1>ব্রেকিং নিউজ টিকার</h1>
            <p>স্ক্রলিং সংবাদ টিকার পরিচালনা করুন</p>
        </div>
        <a href="/Ticker/TickerCreate" class="btn-add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            <span class="btn-add-text">নতুন টিকার যোগ</span>
        </a>
    </div>

    <!-- Stats -->
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-label">মোট</div>
            <div class="stat-value">@Model.Count</div>
        </div>
        <div class="stat-card success">
            <div class="stat-label">সক্রিয়</div>
            <div class="stat-value" id="activeCount">@Model.Count(t => t.IsActive)</div>
        </div>
        <div class="stat-card danger">
            <div class="stat-label">নিষ্ক্রিয়</div>
            <div class="stat-value" id="inactiveCount">@Model.Count(t => !t.IsActive)</div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <div class="table-toolbar">
            <div class="search-box">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" placeholder="সংবাদ খুঁজুন…" id="searchInput" oninput="filterRows()" />
            </div>
            <span class="table-count" id="countLabel">@Model.Count টি সংবাদ</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <span class="empty-icon">📺</span>
                <p>এখনও কোনো ব্রেকিং নিউজ যোগ করা হয়নি।</p>
                <a href="/Ticker/TickerCreate" class="btn-add">প্রথম টিকার যোগ করুন</a>
            </div>
        }
        else
        {
            <!-- ── Desktop Table ── -->
            <div class="table-scroll desktop-table">
                <table class="data-table" id="tickerTable">
                    <thead>
                        <tr>
                            <th class="center" style="width:50px">ক্রম</th>
                            <th>সংবাদ টেক্সট</th>
                            <th class="center" style="width:105px">অবস্থা</th>
                            <th class="center" style="width:145px">কার্যক্রম</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @foreach (var t in Model.OrderBy(t => t.SortOrder))
                        {
                            <tr data-text="@t.Text.ToLower()" data-id="@t.Id">
                                <td class="center"><span class="order-chip">@t.SortOrder</span></td>
                                <td class="news-text-cell"><div class="news-text">@t.Text</div></td>
                                <td class="center">
                                    <div class="toggle-wrap">
                                        <label class="toggle-switch" id="desk-label-@t.Id">
                                            <input type="checkbox"
                                                   data-id="@t.Id"
                                                   data-role="desk"
                                                   @(t.IsActive ? "checked" : "") />
                                            <span class="toggle-slider"></span>
                                        </label>
                                        <span class="toggle-label @(t.IsActive ? "active" : "inactive")" id="desk-text-@t.Id">
                                            @(t.IsActive ? "সক্রিয়" : "নিষ্ক্রিয়")
                                        </span>
                                    </div>
                                </td>
                                <td class="center">
                                    <div class="action-group">
                                        <a href="/Ticker/TickerEdit/@t.Id" class="btn-edit">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                            </svg>
                                            <span class="btn-txt">সম্পাদনা</span>
                                        </a>
                                        <form method="post" action="/Ticker/TickerDelete/@t.Id" style="display:inline" onsubmit="return confirmDelete()">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-delete">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6" />
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                                </svg>
                                                <span class="btn-txt">মুছুন</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── Mobile Cards ── -->
            <div class="mobile-list" id="mobileList">
                @foreach (var t in Model.OrderBy(t => t.SortOrder))
                {
                    <div class="news-card" data-text="@t.Text.ToLower()" data-id="@t.Id">
                        <div class="order-chip" style="margin-top:2px">@t.SortOrder</div>
                        <div class="news-card-body">
                            <div class="news-card-title">@t.Text</div>
                            <div class="news-card-footer">
                                <div class="toggle-inline">
                                    <label class="toggle-switch" id="mob-label-@t.Id">
                                        <input type="checkbox"
                                               data-id="@t.Id"
                                               data-role="mob"
                                               @(t.IsActive ? "checked" : "") />
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span class="toggle-label @(t.IsActive ? "active" : "inactive")" id="mob-text-@t.Id">
                                        @(t.IsActive ? "সক্রিয়" : "নিষ্ক্রিয়")
                                    </span>
                                </div>
                                <div class="card-actions">
                                    <a href="/Ticker/TickerEdit/@t.Id" class="btn-edit">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                        সম্পাদনা
                                    </a>
                                    <form method="post" action="/Ticker/TickerDelete/@t.Id" style="display:inline" onsubmit="return confirmDelete()">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-delete">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            </svg>
                                            মুছুন
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
    // ─────────────────────────────────────────
    // State: server থেকে initial data
    // ─────────────────────────────────────────
    const tickerTexts = {
        @foreach (var t in Model)
        {
                    @:@t.Id: { text: "@Html.Raw(t.Text.Replace("\"", "\\\""))", active: @t.IsActive.ToString().ToLower() },
        }
    };

    // ─────────────────────────────────────────
    // Event delegation — inline onchange নয়
    // এতে CSS দিয়ে hidden থাকা desktop toggle
    // mobile-এ fire করবে না
    // ─────────────────────────────────────────
    document.addEventListener('change', function (e) {
        const cb = e.target;
        if (!cb.matches('input[type="checkbox"][data-id]')) return;

        const id     = parseInt(cb.dataset.id, 10);
        const isActive = cb.checked;
        handleToggle(id, isActive);
    });

    // ─────────────────────────────────────────
    // Core toggle — একবারই API call হবে
    // ─────────────────────────────────────────
    async function handleToggle(id, isActive) {
        // উভয় checkbox silently sync (change event fire না করে)
        setCheckboxSilent(`desk-label-${id}`, isActive);
        setCheckboxSilent(`mob-label-${id}`,  isActive);

        // Loading state
        setLoading(id, true);

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const res = await fetch(`/Ticker/TickerToggle/${id}`, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body   : JSON.stringify({ isActive })
            });

            if (!res.ok) throw new Error();

            tickerTexts[id].active = isActive;
            updateLabel(id, isActive);
            updateStats();
            updateTickerPreview();
            showToast(isActive ? '✓ সক্রিয় করা হয়েছে' : '✓ নিষ্ক্রিয় করা হয়েছে', 'success');

        } catch {
            // Rollback
            const prev = !isActive;
            tickerTexts[id].active = prev;
            setCheckboxSilent(`desk-label-${id}`, prev);
            setCheckboxSilent(`mob-label-${id}`,  prev);
            updateLabel(id, prev);
            showToast('ত্রুটি! আবার চেষ্টা করুন।', 'error');

        } finally {
            setLoading(id, false);
        }
    }

    // checkbox-এর checked property programmatically set করে —
    // এতে 'change' event trigger হয় না, তাই double-fire নেই
    function setCheckboxSilent(labelId, checked) {
        const label = document.getElementById(labelId);
        if (!label) return;
        const cb = label.querySelector('input[type="checkbox"]');
        if (cb) cb.checked = checked;
    }

    function setLoading(id, loading) {
        [`desk-label-${id}`, `mob-label-${id}`].forEach(lid => {
            const label = document.getElementById(lid);
            if (!label) return;
            label.classList.toggle('loading', loading);
            const cb = label.querySelector('input');
            if (cb) cb.disabled = loading;
        });
    }

    function updateLabel(id, isActive) {
        [`desk-text-${id}`, `mob-text-${id}`].forEach(tid => {
            const el = document.getElementById(tid);
            if (!el) return;
            el.textContent = isActive ? 'সক্রিয়' : 'নিষ্ক্রিয়';
            el.className   = `toggle-label ${isActive ? 'active' : 'inactive'}`;
        });
    }

    // ─────────────────────────────────────────
    // Stats update
    // ─────────────────────────────────────────
    function updateStats() {
        const vals = Object.values(tickerTexts);
        document.getElementById('activeCount').textContent   = vals.filter(t => t.active).length;
        document.getElementById('inactiveCount').textContent = vals.filter(t => !t.active).length;
    }

    // ─────────────────────────────────────────
    // Ticker preview rebuild
    // ─────────────────────────────────────────
    function updateTickerPreview() {
        const wrapper = document.getElementById('tickerPreviewWrapper');
        const active  = Object.entries(tickerTexts).filter(([, v]) => v.active);

        if (!active.length) { wrapper.innerHTML = ''; return; }

        const items = active.map(([, v]) =>
            `<span>${escHtml(v.text)}</span><span class="ticker-sep">◆</span>`
        ).join('');

        wrapper.innerHTML = `
            <div class="ticker-preview" style="margin-bottom:1.25rem">
                <div class="ticker-label"><span class="dot"></span>লাইভ</div>
                <div class="ticker-scroll-wrapper">
                    <div class="ticker-scroll">${items}</div>
                </div>
            </div>`;
    }

    function escHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ─────────────────────────────────────────
    // Delete confirm
    // ─────────────────────────────────────────
    function confirmDelete() {
        return confirm('এই সংবাদটি স্থায়ীভাবে মুছে ফেলবেন?');
    }

    // ─────────────────────────────────────────
    // Search / Filter — CSS visibility দেখে
    // ─────────────────────────────────────────
    function filterRows() {
        const q = document.getElementById('searchInput').value.toLowerCase();

        // Desktop rows
        let deskVisible = 0;
        document.querySelectorAll('#tableBody tr').forEach(r => {
            const show = r.dataset.text.includes(q);
            r.style.display = show ? '' : 'none';
            if (show) deskVisible++;
        });

        // Mobile cards
        let mobVisible = 0;
        document.querySelectorAll('#mobileList .news-card').forEach(c => {
            const show = c.dataset.text.includes(q);
            c.style.display = show ? 'flex' : 'none';
            if (show) mobVisible++;
        });

        // যে view visible সেটার count দেখাও
        const isMobile = window.getComputedStyle(
            document.querySelector('.mobile-list')
        ).display !== 'none';

        document.getElementById('countLabel').textContent =
            `${isMobile ? mobVisible : deskVisible} টি সংবাদ`;
    }

    // ─────────────────────────────────────────
    // Toast
    // ─────────────────────────────────────────
    function showToast(msg, type = 'success') {
        const c  = document.getElementById('toastContainer');
        const el = document.createElement('div');
        el.className = `toast ${type}`;
        el.innerHTML = type === 'success'
            ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>${msg}`
            : `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${msg}`;
        c.appendChild(el);
        setTimeout(() => {
            el.classList.add('hide');
            el.addEventListener('animationend', () => el.remove());
        }, 3000);
    }
</script>
