@model VillageInfoSystem.Models.TickerNews
@{
    ViewData["Title"] = "ব্রেকিং নিউজ সম্পাদনা";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --primary: #1a3a5c;
        --primary-light: #2563a8;
        --red: #c0392b;
        --success: #1a7a4a;
        --surface: #ffffff;
        --surface-alt: #f5f7fa;
        --border: #dde3ec;
        --text-main: #1a2636;
        --text-muted: #5a6b80;
        --shadow-sm: 0 2px 8px rgba(26,58,92,0.07);
        --radius: 12px;
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }

    /* ── Page Header ── */
    .edit-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .edit-header-left h2 {
        font-family: 'Noto Serif Bengali', Georgia, serif;
        font-size: clamp(1.05rem, 3.5vw, 1.4rem);
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 0.2rem;
    }

    .edit-header-left p {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.84rem;
        font-weight: 600;
        text-decoration: none;
        border: 1.5px solid var(--border);
        color: var(--text-main);
        background: var(--surface);
        white-space: nowrap;
        flex-shrink: 0;
        transition: border-color 0.2s, background 0.2s, transform 0.15s;
    }

        .btn-back:hover {
            border-color: var(--primary-light);
            color: var(--primary);
            background: #f0f5fb;
            transform: translateY(-1px);
        }

    /* ── Card ── */
    .edit-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: clamp(1rem, 4vw, 1.75rem);
        box-shadow: var(--shadow-sm);
        width: 100%;
        max-width: 700px;
    }

    /* ── Form Elements ── */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 1.1rem;
    }

    .form-label {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--text-main);
    }

        .form-label .req {
            color: #e74c3c;
        }

    .form-control {
        width: 100%;
        padding: 0.6rem 0.85rem;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 0.88rem;
        color: var(--text-main);
        background: var(--surface);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        font-family: inherit;
        resize: vertical;
    }

        .form-control:focus {
            border-color: var(--primary-light);
            box-shadow: 0 0 0 3px rgba(37,99,168,0.12);
        }

    textarea.form-control {
        min-height: 90px;
        line-height: 1.55;
    }

    .form-hint {
        font-size: 0.76rem;
        color: var(--text-muted);
    }

    /* ── Grid ── */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.1rem;
    }

    /* ── Checkbox ── */
    .form-check {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        padding: 0.5rem 0;
    }

        .form-check input[type="checkbox"] {
            width: 17px;
            height: 17px;
            accent-color: var(--success);
            cursor: pointer;
            flex-shrink: 0;
        }

    .form-check-label {
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-main);
        user-select: none;
    }

    /* ── Ticker Preview ── */
    .ticker-preview-box {
        background: linear-gradient(90deg, #0d1f0e 0%, #082818 100%);
        border-radius: 10px;
        padding: 0.7rem 1rem;
        margin-bottom: 1.4rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        overflow: hidden;
        border: 1px solid #1a3a1c;
    }

    .ticker-badge {
        background: #dc3545;
        color: white;
        font-size: 0.68rem;
        font-weight: 800;
        padding: 0.22rem 0.55rem;
        border-radius: 4px;
        white-space: nowrap;
        flex-shrink: 0;
        letter-spacing: 0.04em;
    }

    .ticker-preview-text {
        color: rgba(255,255,255,0.85);
        font-size: 0.84rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        min-width: 0;
    }

    /* Character counter */
    .char-counter {
        font-size: 0.74rem;
        color: var(--text-muted);
        text-align: right;
        margin-top: 0.2rem;
    }

        .char-counter.warn {
            color: #e67e22;
        }

        .char-counter.danger {
            color: #e74c3c;
        }

    /* ── Action Buttons ── */
    .form-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.6rem 1.3rem;
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(26,58,92,0.18);
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        white-space: nowrap;
    }

        .btn-submit:hover {
            background: var(--primary-light);
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(26,58,92,0.22);
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1.1rem;
        background: var(--surface);
        color: var(--text-main);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, transform 0.15s;
        white-space: nowrap;
    }

        .btn-cancel:hover {
            border-color: var(--primary-light);
            background: #f0f5fb;
            transform: translateY(-1px);
        }

    /* ══════════════════════════
           RESPONSIVE
        ══════════════════════════ */
    @@media (max-width: 640px) {
        .edit-header {
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.1rem;
        }

        .btn-back {
            align-self: flex-start;
            padding: 0.42rem 0.85rem;
            font-size: 0.8rem;
        }

        .edit-card {
            padding: 1rem;
            border-radius: 10px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-control {
            font-size: 0.85rem;
            padding: 0.55rem 0.78rem;
        }

        .form-label {
            font-size: 0.81rem;
        }

        .ticker-preview-box {
            padding: 0.6rem 0.8rem;
            gap: 0.55rem;
            border-radius: 8px;
        }

        .ticker-badge {
            font-size: 0.62rem;
            padding: 0.18rem 0.45rem;
        }

        .ticker-preview-text {
            font-size: 0.8rem;
        }

        .btn-submit, .btn-cancel {
            font-size: 0.84rem;
            padding: 0.55rem 1rem;
        }

        .form-actions {
            gap: 0.55rem;
        }
    }

    @@media (max-width: 400px) {
        .edit-card {
            padding: 0.85rem;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-submit, .btn-cancel {
            width: 100%;
            justify-content: center;
        }

        .ticker-preview-box {
            gap: 0.45rem;
        }
    }
</style>

<div class="edit-header">
    <div class="edit-header-left">
        <h2>✏️ ব্রেকিং নিউজ সম্পাদনা</h2>
        <p>টিকার নিউজের তথ্য আপডেট করুন</p>
    </div>
    <a href="/Ticker/TickerList" class="btn-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
        </svg>
        তালিকায় ফিরুন
    </a>
</div>

<div class="edit-card">
    <form method="post" action="/Ticker/TickerEdit/@Model.Id">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <!-- Text -->
        <div class="form-group">
            <label class="form-label">
                📝 টিকার টেক্সট <span class="req">*</span>
            </label>
            <textarea name="Text"
                      id="tickerText"
                      class="form-control"
                      rows="3"
                      required
                      maxlength="300">@Model.Text</textarea>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.2rem;">
                <span class="form-hint">সর্বোচ্চ ৩০০ অক্ষর।</span>
                <span class="char-counter" id="charCounter">@Model.Text.Length / 300</span>
            </div>
        </div>

        <!-- Grid: SortOrder + IsActive -->
        <div class="form-grid">
            <div class="form-group" style="margin-bottom:0">
                <label class="form-label">🔢 ক্রম নম্বর</label>
                <input type="number" name="SortOrder" class="form-control"
                       value="@Model.SortOrder" min="0" />
            </div>
            <div class="form-group" style="margin-bottom:0; justify-content:flex-end; padding-top:1.6rem;">
                <label class="form-check">
                    <input type="checkbox" name="IsActive" value="true"
                           @(Model.IsActive ? "checked" : "") />
                    <span class="form-check-label">সক্রিয় রাখুন</span>
                </label>
                <input type="hidden" name="IsActive" value="false" />
            </div>
        </div>

        <!-- Live Preview -->
        <div class="ticker-preview-box" style="margin-top:1.1rem;">
            <span class="ticker-badge">🔴 সর্বশেষ</span>
            <span class="ticker-preview-text" id="tickerPreview">@Model.Text</span>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                    <polyline points="17 21 17 13 7 13 7 21" />
                    <polyline points="7 3 7 8 15 8" />
                </svg>
                আপডেট করুন
            </button>
            <a href="/Ticker/TickerList" class="btn-cancel">
                বাতিল
            </a>
        </div>
    </form>
</div>

<script>
    const textarea    = document.getElementById('tickerText');
    const preview     = document.getElementById('tickerPreview');
    const charCounter = document.getElementById('charCounter');
    const maxLen      = 300;

    function updatePreview() {
        const val = textarea.value;
        preview.textContent = val.trim() || '...';

        const len = val.length;
        charCounter.textContent = `${len} / ${maxLen}`;
        charCounter.className = 'char-counter';
        if (len >= maxLen)        charCounter.classList.add('danger');
        else if (len >= maxLen * 0.8) charCounter.classList.add('warn');
    }

    textarea.addEventListener('input', updatePreview);
    updatePreview();
</script>